{
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "extends": ["eslint:recommended", "standard"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "semi": ["error", "always"],
    "quotes": ["error", "single"],
    "indent": ["error", 2],
    "space-before-function-paren": ["error", "never"]
  },
  "globals": {
    "bootstrap": "readonly",
    "Tabulator": "readonly",
    "luxon": "readonly",
    "XLSX": "readonly",
    "DOMPurify": "readonly",
    "HelpWidget": "readonly",
    "echarts": "readonly"
  }
}
