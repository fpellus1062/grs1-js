      '<button type="button" class="btn btn-danger" id="btnRunAsigDelete"><i class="bi bi-trash me-1"></i>Eliminar</button>' +
      "</div>" +
      "</div>" +
      "</div>" +
      "</div>";
    document.body.appendChild(wrapper.firstChild);
    var modal = document.getElementById("asigDeleteModal");
    makeModalDraggable(modal);
    return modal;
  }

