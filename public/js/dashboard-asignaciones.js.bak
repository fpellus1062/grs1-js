  function agenteNombre(ag) {
    return [
      ag.apellido_1 || ag.agente_apellido1,
      ag.apellido_2 || ag.agente_apellido2,
      ag.nombre || ag.agente_nombre,
    ]
      .filter(Boolean)
      .join(" ");
  }

  function headers() {
    return { Authorization: "Bearer " + app.globalState.token };
  }

  const BULK_REQUEST_AGENT_CHUNK_SIZE = Number(
    window.BULK_REQUEST_AGENT_CHUNK_SIZE || 50,
  );

  function chunkItems(items, chunkSize) {
    var safeSize = Math.max(1, Number(chunkSize) || 1);
    var chunks = [];
    for (var i = 0; i < items.length; i += safeSize) {
      chunks.push(items.slice(i, i + safeSize));
    }
    return chunks;
  }

  function updateBulkProgress(percent, text) {
    var wrap = document.getElementById("asigBulkProgressWrap");
    var bar = document.getElementById("asigBulkProgressBar");
    var label = document.getElementById("asigBulkProgressText");
    if (!wrap || !bar || !label) return;

    var value = Math.max(0, Math.min(100, Number(percent) || 0));
    wrap.classList.remove("d-none");
    bar.style.width = value + "%";
    bar.setAttribute("aria-valuenow", String(Math.round(value)));
    bar.textContent = Math.round(value) + "%";
    label.textContent = text || "Procesando...";
  }

  function resetBulkProgress() {
    var wrap = document.getElementById("asigBulkProgressWrap");
    var bar = document.getElementById("asigBulkProgressBar");
    var label = document.getElementById("asigBulkProgressText");
    if (wrap) wrap.classList.add("d-none");
    if (bar) {
      bar.style.width = "0%";
      bar.setAttribute("aria-valuenow", "0");
      bar.textContent = "0%";
    }
    if (label) label.textContent = "";
  }

  function showAlert(message, type) {
    const el = document.getElementById("alertContainerAsignaciones");
    if (!el) return;
    el.innerHTML =
      '<div class="alert alert-' +
      type +
      ' alert-dismissible py-1 mb-1 fade show" role="alert">' +
      app.escapeHtml(message) +
      '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
      "</div>";
    setTimeout(function () {
      el.innerHTML = "";
    }, 5000);
  }

  function parseDias(value) {
    return Array.from(
      new Set(
        String(value || "")
          .split(",")
          .map(function (x) {
            return Number(String(x).trim());
          })
          .filter(function (n) {
            return Number.isInteger(n) && n >= 1 && n <= 31;
          }),
      ),
    ).sort(function (a, b) {
      return a - b;
    });
  }

  function resolvePlanningDatesFromDays(anio, mes, dias) {
    const wanted = new Set(
      (dias || []).map(function (n) {
        return Number(n);
      }),
    );
    return getPlanningWindow(anio, mes)
      .filter(function (day) {
        return wanted.has(Number(day.dia));
      })
      .map(function (day) {
        return day.key;
      });
  }

  function renderDeleteDateOptions(anio, mes) {
    var container = document.getElementById("asigDeleteDates");
    var summary = document.getElementById("asigDeleteDatesSummary");
    if (!container) return;

    var planningDays = getPlanningWindow(anio, mes);
    var weeks = [];
    for (var i = 0; i < planningDays.length; i += 7) {
      weeks.push(planningDays.slice(i, i + 7));
    }

    container.innerHTML = weeks
      .map(function (week, weekIndex) {
        return (
          '<div class="d-flex gap-1 mb-1" data-week="' +
          weekIndex +
          '">' +
          week
            .map(function (day) {
              var weekend = day.weekdayIndex >= 5;
              return (
                '<label class="border rounded px-1 py-1 small text-center" style="width:52px;min-width:52px;cursor:pointer;line-height:1.1;background:' +
                (weekend ? "#fff8e1" : "#f8f9fa") +
                '">' +
                '<input class="form-check-input mb-1 asig-delete-date-check" type="checkbox" value="' +
                app.escapeHtml(day.key) +
                '" data-dia="' +
                day.dia +
                '">' +
                '<div class="fw-semibold" style="font-size:.72rem">' +
                app.escapeHtml(day.label) +
                "</div>" +
                '<div style="font-size:.7rem">' +
                app.escapeHtml(day.labelDate) +
                "</div>" +
                "</label>"
              );
            })
            .join("") +
          "</div>"
        );
      })
      .join("");

    function updateSummary() {
      var checked = container.querySelectorAll(
        ".asig-delete-date-check:checked",
      ).length;
      if (summary) {
        summary.textContent = checked
          ? "Fechas seleccionadas: " + checked
          : "Seleccione una o varias fechas visibles del cuadrante.";
      }
    }

    container
      .querySelectorAll(".asig-delete-date-check")
      .forEach(function (input) {
        input.addEventListener("change", updateSummary);
      });
    updateSummary();
  }

  function getSelectedDeleteDates() {
    return Array.from(
      document.querySelectorAll(
        "#asigDeleteDates .asig-delete-date-check:checked",
      ),
    )
      .map(function (input) {
