  function getSelectedNumbersFromSelect(selectEl) {
    return Array.from(selectEl?.selectedOptions || [])
      .map(function (opt) {
        return Number(opt.value);
      })
      .filter(Boolean);
  }

  function makeModalDraggable(modalEl) {
    if (!modalEl || modalEl.dataset.draggableBound === "1") return;
    const dialog = modalEl.querySelector(".modal-dialog");
    const header = modalEl.querySelector(".modal-header");
    if (!dialog || !header) return;

    modalEl.dataset.draggableBound = "1";
    header.style.cursor = "move";

    let dragging = false;
    let startMouseX = 0;
    let startMouseY = 0;
    let startOffsetX = 0;
    let startOffsetY = 0;
    let offsetX = 0;
    let offsetY = 0;

    function applyTransform(x, y) {
      dialog.style.transform = "translate(" + x + "px, " + y + "px)";
    }

    function resetPosition() {
      offsetX = 0;
      offsetY = 0;
      dialog.style.transform = "";
    }

    modalEl.addEventListener("shown.bs.modal", function () {
      resetPosition();
    });

    modalEl.addEventListener("hidden.bs.modal", function () {
      dragging = false;
      resetPosition();
    });

    header.addEventListener("mousedown", function (ev) {
      if (ev.target.closest("button")) return;
      dragging = true;
      startMouseX = ev.clientX;
      startMouseY = ev.clientY;
      startOffsetX = offsetX;
      startOffsetY = offsetY;
      ev.preventDefault();
    });

    document.addEventListener("mousemove", function (ev) {
      if (!dragging) return;

      let nextX = startOffsetX + (ev.clientX - startMouseX);
      let nextY = startOffsetY + (ev.clientY - startMouseY);

      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const rect = dialog.getBoundingClientRect();

      const projectedLeft = rect.left + (nextX - offsetX);
      const projectedTop = rect.top + (nextY - offsetY);

      if (projectedLeft < 0) nextX += -projectedLeft;
      if (projectedLeft + rect.width > vw)
        nextX -= projectedLeft + rect.width - vw;
      if (projectedTop < 0) nextY += -projectedTop;
      if (projectedTop + 80 > vh) nextY -= projectedTop + 80 - vh;

      offsetX = nextX;
      offsetY = nextY;
      applyTransform(offsetX, offsetY);
    });

    document.addEventListener("mouseup", function () {
      dragging = false;
    });
  }

  function getPeriodo() {
    const anio = Number(document.getElementById("asigAnio")?.value);
    const mes = Number(document.getElementById("asigMes")?.value);
    return { anio, mes };
  }

  function getSelectedBorradorId() {
    const id = Number(document.getElementById("asigBorrador")?.value || 0);
    return id > 0 ? id : null;
  }

  function updateObsBtnStyle() {
    var btn = document.getElementById("btnEditObservacionesBorrador");
    if (!btn) return;
    var borradorId = getSelectedBorradorId();
    var borradores = app.asignacionesState.borradores || [];
    var borrador = borradores.find(function (b) { return Number(b.id) === Number(borradorId); });
    var tieneObs = borrador && borrador.observaciones && borrador.observaciones.trim();
    btn.className = tieneObs
      ? 'btn btn-outline-primary btn-sm px-2 py-1'
      : 'btn btn-outline-secondary btn-sm px-2 py-1';
    btn.title = tieneObs
      ? 'Ver/editar observaciones del borrador'
      : 'Crear observaciones del borrador';
  }

  function renderBorradoresSelect(items, selectedId) {
    const sel = document.getElementById("asigBorrador");
    if (!sel) return;

    const rows = Array.isArray(items) ? items : [];
    if (!rows.length) {
      sel.innerHTML = '<option value="">Sin borradores</option>';
      sel.value = "";
      app.asignacionesState.borradorId = null;
      app.asignacionesState.borradores = [];
      return;
    }

    sel.innerHTML = rows
      .map(function (b) {
        const tag = b.estado === "validado" ? " (validado)" : "";
        const owner = b.propietario_username
          ? " · " + b.propietario_username
          : "";
        return (
          '<option value="' +
          b.id +
          '">' +
          app.escapeHtml(
            (b.nombre || "Borrador") + " v" + (b.version || 1) + tag + owner,
          ) +
          "</option>"
        );
      })
      .join("");

    const exists = rows.some(function (b) {
      return Number(b.id) === Number(selectedId);
    });
    sel.value = String(exists ? selectedId : rows[0].id);

    app.asignacionesState.borradorId = Number(sel.value);
    app.asignacionesState.borradores = rows;
    updateObsBtnStyle();
  }

  app.loadAsignacionesBorradores = async function loadAsignacionesBorradores(
    preferredId,
  ) {
    const p = getPeriodo();
    if (!p.anio || !p.mes) return;
    try {
      const res = await fetch(
        "/api/asignaciones/borradores/" + p.anio + "/" + p.mes,
        { headers: headers() },
      );
      if (!res.ok) throw new Error("No se pudieron cargar borradores");
      const json = await res.json();
      const list =
        json && Array.isArray(json.borradores) ? json.borradores : [];
      renderBorradoresSelect(
        list,
        preferredId || app.asignacionesState.borradorId || null,
      );
    } catch (e) {
      renderBorradoresSelect([], null);
      showAlert(e.message, "danger");
    }
  };

  function daysInMonth(anio, mes) {
    return new Date(anio, mes, 0).getDate();
  }

  function toIsoDate(dateObj) {
    var y = dateObj.getFullYear();
    var m = String(dateObj.getMonth() + 1).padStart(2, "0");
    var d = String(dateObj.getDate()).padStart(2, "0");
    return y + "-" + m + "-" + d;
  }

  function getPlanningWindow(anio, mes) {
    var first = new Date(anio, mes - 1, 1);
    var mondayOffset = (first.getDay() + 6) % 7; // Monday=0..Sunday=6
    var start = new Date(anio, mes - 1, 1 - mondayOffset);
    var days = [];
    for (var i = 0; i < 28; i += 1) {
      var dt = new Date(start);
      dt.setDate(start.getDate() + i);
      days.push({
        key: toIsoDate(dt),
        anio: dt.getFullYear(),
        mes: dt.getMonth() + 1,
        dia: dt.getDate(),
        weekdayIndex: i % 7,
        label: WEEKDAY_SHORT[i % 7],
        labelDate:
          String(dt.getDate()).padStart(2, "0") +
          "/" +
          String(dt.getMonth() + 1).padStart(2, "0"),
      });
    }

    return days;
  }

  function periodoKey(anio, mes) {
    return String(anio) + "-" + String(mes).padStart(2, "0");
  }

  function normalizeAgenteId(value) {
    return Number(value || 0);
  }

  function normalizeSearchText(value) {
    return String(value || "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim();
  }

  function getAgentSearchTerm() {
    return normalizeSearchText(app.asignacionesState.searchTerm || "");
  }

  function updateSearchSummary(visibleCount, totalCount) {
    var el = document.getElementById("asigSearchSummary");
    if (!el) return;

    var term = String(app.asignacionesState.searchTerm || "").trim();
    if (!term) {
      el.textContent = "Sin filtro activo";
      return;
    }

    el.textContent =
      "Mostrando " +
      visibleCount +
      " de " +
      totalCount +
      ' agente(s) para "' +
      term +
      '"';
  }

  function getTurnoLabel(entry) {
    const codigo = entry.turno_codigo || "-";
    const nombre = entry.turno_nombre || "";
    return nombre ? codigo + " · " + nombre : codigo;
  }

  function getActividadLabelById(id) {
    const actividades =
      (app.asignacionesState.meta && app.asignacionesState.meta.actividades) ||
      [];
    const item = actividades.find(function (actividad) {
      return Number(actividad.id_actividad) === Number(id);
    });
    if (!item) return String(id);
    return item.codigo ? item.codigo + " · " + item.nombre : item.nombre;
  }

  function getSelectedHistorialAgentIds() {
    return Array.from(
      new Set(
        (app.asignacionesState.selectedAgenteIdsVista || [])
          .map(function (id) {
            return Number(id);
          })
          .filter(function (id) {
            return Number.isInteger(id) && id > 0;
          }),
      ),
    );
  }

  function getCurrentBorradorLabel() {
    var borradorId = getSelectedBorradorId();
    if (!borradorId) return "Sin borrador seleccionado";
    var borrador = (app.asignacionesState.borradores || []).find(
      function (item) {
        return Number(item.id) === Number(borradorId);
      },
    );
    if (!borrador) return "Borrador #" + borradorId;
    var estado = borrador.estado === "validado" ? "validado" : "borrador";
    return (
      (borrador.nombre || "Borrador") +
      " v" +
      (borrador.version || 1) +
      " · " +
      estado
    );
  }

  function getHistorialActionOptions() {
    return [
      { value: "BORRADOR_CREAR", label: "Alta en borrador" },
      { value: "BORRADOR_EDITAR", label: "Edición en borrador" },
      { value: "BORRADOR_CREAR_MASIVO", label: "Alta masiva" },
      { value: "BORRADOR_EDITAR_MASIVO", label: "Edición masiva" },
      { value: "BORRADOR_BULK", label: "Asignación masiva" },
      { value: "BORRADOR_ELIMINAR", label: "Eliminación en borrador" },
      { value: "BORRADOR_COPIAR_MES", label: "Copia de mes" },
      { value: "BORRADOR_ELIMINADO", label: "Borrador eliminado" },
      { value: "VALIDAR", label: "Validación" },
      { value: "REVALIDAR", label: "Revalidación" },
    ];
  }

  function ensureHistorialFilterControls() {
    var actionEl = document.getElementById("asigHistorialFiltroAccion");
    if (actionEl && !actionEl.dataset.ready) {
      actionEl.innerHTML = getHistorialActionOptions()
        .map(function (item) {
          var id = "asigAccCb_" + item.value;
          return (
            '<label style="display:flex;align-items:center;gap:5px;padding:2px 0;cursor:pointer;white-space:nowrap;">'
            + '<input type="checkbox" id="' + id + '" value="' + app.escapeHtml(item.value) + '" style="cursor:pointer;">'
            + '<span>' + app.escapeHtml(item.label) + '</span>'
            + '</label>'
          );
        })
        .join("");
      actionEl.dataset.ready = "1";
    }
  }

  function getHistorialUiFilters() {
    var actionEl = document.getElementById("asigHistorialFiltroAccion");
    var dateEl = document.getElementById("asigHistorialFiltroFechaCambio");
    var acciones = actionEl
      ? Array.from(actionEl.querySelectorAll('input[type=checkbox]:checked')).map(function (cb) { return cb.value; })
      : [];
    var fechasCambio = dateEl
      ? Array.from(dateEl.querySelectorAll('input[type=checkbox]:checked')).map(function (cb) { return cb.value; })
      : [];
    return {
      acciones: acciones,
      usuario_id: document.getElementById("asigHistorialFiltroUsuario")?.value || "",
      fechas_cambio: fechasCambio,
    };
  }

  function hasActiveHistorialFilters() {
    var uiFilters = getHistorialUiFilters();
    return Boolean(
      (uiFilters.acciones && uiFilters.acciones.length) ||
      uiFilters.usuario_id ||
      (uiFilters.fechas_cambio && uiFilters.fechas_cambio.length),
    );
  }

  function updateHistorialApplyButtonState() {
    var btnEl = document.getElementById("btnAsigHistorialAplicarFiltros");
    if (!btnEl) return;
    btnEl.disabled = !hasActiveHistorialFilters();
  }

  function resetHistorialUiFilters() {
    var actionEl = document.getElementById("asigHistorialFiltroAccion");
    var userEl = document.getElementById("asigHistorialFiltroUsuario");
    var dateEl = document.getElementById("asigHistorialFiltroFechaCambio");
    if (actionEl) actionEl.querySelectorAll('input[type=checkbox]').forEach(function (cb) { cb.checked = false; });
    if (userEl) userEl.value = "";
    if (dateEl) dateEl.querySelectorAll('input[type=checkbox]').forEach(function (cb) { cb.checked = false; });
    updateHistorialApplyButtonState();
  }

  function populateHistorialUsers(logs) {
    var userEl = document.getElementById("asigHistorialFiltroUsuario");
    if (!userEl) return;
    var selected = userEl.value || "";
    var users = [];
    var seen = new Set();
    (logs || []).forEach(function (entry) {
      var userId = Number(entry.usuario_id || 0);
      if (!userId || seen.has(userId)) return;
      seen.add(userId);
      users.push({
        id: userId,
        label: entry.usuario_nombre || "Usuario #" + userId,
      });
    });
    users.sort(function (a, b) {
      return a.label.localeCompare(b.label, "es", { sensitivity: "base" });
    });
    userEl.innerHTML =
      '<option value="">Todos los usuarios</option>' +
      users
        .map(function (user) {
          return (
            '<option value="' +
            user.id +
            '">' +
            app.escapeHtml(user.label) +
            "</option>"
          );
        })
        .join("");
    userEl.value = users.some(function (user) {
      return String(user.id) === String(selected);
    })
      ? String(selected)
      : "";
    updateHistorialApplyButtonState();
  }

  function populateHistorialDates(logs) {
    var dateEl = document.getElementById("asigHistorialFiltroFechaCambio");
    if (!dateEl) return;

    var selected = new Set(
      Array.from(dateEl.querySelectorAll('input[type=checkbox]:checked')).map(function (cb) {
        return String(cb.value);
      }),
    );

    var uniqueDates = [];
    var seen = new Set();
    (logs || []).forEach(function (entry) {
      var key = normalizeDateKey(entry.created_at);
      if (!key || seen.has(key)) return;
      seen.add(key);
      uniqueDates.push(key);
    });

    uniqueDates.sort(function (a, b) {
      return b.localeCompare(a);
    });

    if (!uniqueDates.length) {
      dateEl.innerHTML = '<div class="text-muted small">Sin fechas disponibles</div>';
      return;
    }

    dateEl.innerHTML = uniqueDates
      .map(function (dateKey, idx) {
        var id = "asigFechaCambioCb_" + idx;
        var checked = selected.has(dateKey) ? " checked" : "";
        return (
          '<label style="display:flex;align-items:center;gap:5px;padding:2px 0;cursor:pointer;white-space:nowrap;">'
          + '<input type="checkbox" id="' + id + '" value="' + app.escapeHtml(dateKey) + '" style="cursor:pointer;"' + checked + '>'
          + '<span>' + app.escapeHtml(formatHistorialDate(dateKey, false)) + '</span>'
          + '</label>'
        );
      })
      .join("");
    updateHistorialApplyButtonState();
  }

  async function preloadAsignacionesHistorialFilterOptions() {
    var filters = getHistorialFilters();
    var userEl = document.getElementById("asigHistorialFiltroUsuario");
    var dateEl = document.getElementById("asigHistorialFiltroFechaCambio");

    if (userEl) {
      userEl.innerHTML = '<option value="">Cargando usuarios...</option>';
      userEl.value = "";
    }
    if (dateEl) {
      dateEl.innerHTML = '<div class="text-muted small">Cargando fechas...</div>';
    }

    if (!filters.periodo.anio || !filters.periodo.mes || !filters.agentIds.length || !filters.borradorId) {
      if (userEl) {
        userEl.innerHTML = '<option value="">Todos los usuarios</option>';
      }
      if (dateEl) {
        dateEl.innerHTML = '<div class="text-muted small">Sin fechas disponibles</div>';
      }
      app.asignacionesState.historialDateSourceLogs = [];
      return;
    }

    try {
      var queryString = buildHistorialQueryString({
        acciones: [],
        usuario_id: "",
        fechas_cambio: [],
      });
      var response = await fetch("/api/asignaciones/historial?" + queryString, {
        headers: headers(),
      });
      if (!response.ok) {
        throw new Error("No se pudieron cargar los filtros del historial");
      }
      var data = await response.json();
      var logs = Array.isArray(data.logs) ? data.logs : [];
      var total = Number(data.total || 0);
      app.asignacionesState.historialDateSourceLogs = logs.slice();
      renderHistorialResumen(total, filters);
      populateHistorialUsers(logs);
      populateHistorialDates(logs);
    } catch (error) {
      if (userEl) {
        userEl.innerHTML = '<option value="">Todos los usuarios</option>';
      }
      if (dateEl) {
        dateEl.innerHTML = '<div class="text-danger small">No se pudieron cargar las fechas</div>';
      }
      app.asignacionesState.historialDateSourceLogs = [];
      renderHistorialResumen(0, filters);
    }
  }

  function getHistorialFilters() {
    var periodo = getPeriodo();
    var agentIds = getSelectedHistorialAgentIds();
    var borradorId = getSelectedBorradorId();
    var planningDays =
      Array.isArray(app.asignacionesState.cuadranteDays) &&
      app.asignacionesState.cuadranteDays.length
        ? app.asignacionesState.cuadranteDays
        : getPlanningWindow(periodo.anio, periodo.mes);
    return {
      periodo: periodo,
      borradorId: borradorId,
      agentIds: agentIds,
      fechas: planningDays.map(function (day) { return day.key; }),
      nombreBorrador: getCurrentBorradorLabel(),
    };
  }

  function buildHistorialQueryString(extraFilters) {
    var filters = getHistorialFilters();
    var uiFilters = extraFilters || getHistorialUiFilters();
    var params = new URLSearchParams({
      anio: String(filters.periodo.anio),
      mes: String(filters.periodo.mes),
      nombre_borrador: filters.nombreBorrador,
      page: "1",
      limit: "5000",
    });
    if (filters.borradorId)
      params.set("borrador_id", String(filters.borradorId));
    if (filters.agentIds.length)
      params.set("agente_ids", filters.agentIds.join(","));
    if (uiFilters.acciones && uiFilters.acciones.length) params.set("acciones", uiFilters.acciones.join(","));
    if (uiFilters.usuario_id)
      params.set("usuario_id", String(uiFilters.usuario_id));
    if (uiFilters.fechas_cambio && uiFilters.fechas_cambio.length)
      params.set("fechas_cambio", uiFilters.fechas_cambio.join(","));
    return params.toString();
  }

  function formatHistorialDate(value, withTime) {
    if (!value) return "Cuadrante completo";
    var dt = new Date(withTime ? value : String(value) + "T00:00:00");
    return withTime
      ? dt.toLocaleString("es-ES")
      : dt.toLocaleDateString("es-ES");
  }

  function getTurnoLabelById(turnoId) {
    var id = Number(turnoId);
    if (!id) return "—";
    var turnos =
      (app.asignacionesState.meta && app.asignacionesState.meta.turnos) || [];
    var turno = turnos.find(function (item) {
      return Number(item.id_turno) === id;
    });
    if (!turno) return "#" + id;
    return turno.codigo
      ? turno.codigo + (turno.nombre ? " · " + turno.nombre : "")
      : turno.nombre || "#" + id;
  }

  function getHistorialActionLabel(action) {
    var labels = {
      BORRADOR_CREAR: "Alta en borrador",
      BORRADOR_EDITAR: "Edición en borrador",
      BORRADOR_CREAR_MASIVO: "Alta masiva",
      BORRADOR_EDITAR_MASIVO: "Edición masiva",
      BORRADOR_BULK: "Asignación masiva",
      BORRADOR_ELIMINAR: "Eliminación en borrador",
      BORRADOR_COPIAR_MES: "Copia de mes",
      BORRADOR_ELIMINADO: "Borrador eliminado",
      VALIDAR: "Validación",
      REVALIDAR: "Revalidación",
    };
    return labels[action] || action || "Cambio";
  }

  function normalizeHistorialValue(value) {
    if (value === null || value === undefined || value === "") return "—";
    if (Array.isArray(value)) {
      return (
        value
          .map(function (item) {
            return Number.isFinite(Number(item))
              ? getActividadLabelById(item)
              : String(item);
          })
          .join(", ") || "—"
      );
    }
    return String(value);
  }

  function normalizeActividadIds(raw) {
    if (Array.isArray(raw))
      return raw
        .map(function (x) {
          return Number(x);
        })
        .filter(Boolean);
    var n = Number(raw);
    return Number.isFinite(n) && n > 0 ? [n] : [];
  }

  function buildHistorialCellValue(entry) {
    var before =
      entry &&
      entry.datos_anteriores &&
      typeof entry.datos_anteriores === "object"
        ? entry.datos_anteriores
        : {};
    var after =
      entry && entry.datos_nuevos && typeof entry.datos_nuevos === "object"
        ? entry.datos_nuevos
        : {};

    var beforeTurno = getTurnoLabelById(before.turno_id);
    var afterTurno = getTurnoLabelById(after.turno_id);

    var beforeActs =
      normalizeActividadIds(before.actividad_ids)
        .map(function (id) {
          return getActividadLabelById(id);
        })
        .join(", ") || "—";
    var afterActs =
      normalizeActividadIds(after.actividad_ids)
        .map(function (id) {
          return getActividadLabelById(id);
        })
        .join(", ") || "—";

    return {
      beforeTurno: beforeTurno,
      afterTurno: afterTurno,
      beforeActs: beforeActs,
      afterActs: afterActs,
    };
  }

  function normalizeDateKey(value) {
    if (!value) return null;
    var raw = String(value);
    if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) return raw;
    if (/^\d{4}-\d{2}-\d{2}T/.test(raw)) return raw.slice(0, 10);
    var dt = new Date(raw);
    if (!Number.isNaN(dt.getTime())) {
      var y = dt.getFullYear();
      var m = String(dt.getMonth() + 1).padStart(2, "0");
      var d = String(dt.getDate()).padStart(2, "0");
      return y + "-" + m + "-" + d;
    }
    return null;
  }

  function getAgenteMetaMap() {
    var map = new Map();
    (
      (app.asignacionesState.meta && app.asignacionesState.meta.agentes) ||
      []
    ).forEach(function (ag) {
      var id = Number(ag.id_agente || ag.id || 0);
      if (!id) return;
      map.set(id, {
        tip: ag.agente_tip || ag.tip || "",
        nombre: ag.agente_nombre || ag.nombre || "",
        apellido1: ag.agente_apellido1 || ag.apellido_1 || "",
        apellido2: ag.agente_apellido2 || ag.apellido_2 || "",
        empleo: ag.empleo_nombre || "",
      });
    });
    return map;
  }

  function expandBulkHistorialEntries(logs, filters) {
    var agentMap = getAgenteMetaMap();
    var planningDates = (
      filters && Array.isArray(filters.fechas) ? filters.fechas : []
    ).map(function (d) {
      return String(d);
    });
    var byDayNumber = new Map();
    planningDates.forEach(function (iso) {
      var day = Number(String(iso).slice(8, 10));
      if (!byDayNumber.has(day)) byDayNumber.set(day, []);
      byDayNumber.get(day).push(iso);
    });

    var expanded = [];
    (logs || []).forEach(function (entry) {
      var isAgentBulk =
        String(entry.accion || "") === "BORRADOR_CREAR_MASIVO" ||
        String(entry.accion || "") === "BORRADOR_EDITAR_MASIVO";
      var isBulkSummary = String(entry.accion || "") === "BORRADOR_BULK";
      var beforePayload =
        entry &&
        entry.datos_anteriores &&
        typeof entry.datos_anteriores === "object"
          ? entry.datos_anteriores
          : {};
      var afterPayload =
        entry && entry.datos_nuevos && typeof entry.datos_nuevos === "object"
          ? entry.datos_nuevos
          : {};

      if (
        isAgentBulk &&
        afterPayload.fechas &&
        typeof afterPayload.fechas === "object"
      ) {
        var fechasMap = afterPayload.fechas || {};
        Object.keys(fechasMap).forEach(function (fecha) {
          var meta = agentMap.get(Number(entry.agente_id)) || {};
          expanded.push({
            ...entry,
            fecha: fecha,
            agente_tip: meta.tip || entry.agente_tip || "",
            agente_nombre: meta.nombre || entry.agente_nombre || "",
            agente_apellido1: meta.apellido1 || entry.agente_apellido1 || "",
            agente_apellido2: meta.apellido2 || entry.agente_apellido2 || "",
            empleo_nombre: meta.empleo || entry.empleo_nombre || "—",
            datos_anteriores:
              beforePayload.fechas && beforePayload.fechas[fecha]
                ? beforePayload.fechas[fecha]
                : {},
            datos_nuevos: fechasMap[fecha] || {},
          });
        });
        return;
      }

      if (
        !isBulkSummary ||
        !entry.datos_nuevos ||
        typeof entry.datos_nuevos !== "object"
      ) {
        expanded.push(entry);
        return;
      }

      var payload = afterPayload || {};
      var agentIds = Array.isArray(payload.agente_ids)
        ? payload.agente_ids
            .map(function (x) {
              return Number(x);
            })
            .filter(Boolean)
        : [];
      var diasRaw = Array.isArray(payload.dias) ? payload.dias : [];

      var fechas = [];
      diasRaw.forEach(function (d) {
        var dateKey = normalizeDateKey(d);
        if (dateKey) {
          fechas.push(dateKey);
          return;
        }
        var num = Number(d);
        if (!Number.isInteger(num)) return;
        var mapped = byDayNumber.get(num) || [];
        mapped.forEach(function (iso) {
          fechas.push(iso);
        });
      });
      fechas = Array.from(new Set(fechas));

      if (!agentIds.length || !fechas.length) {
        expanded.push(entry);
        return;
      }

      agentIds.forEach(function (agentId) {
        var meta = agentMap.get(agentId) || {};
        fechas.forEach(function (fecha) {
          expanded.push({
            ...entry,
            accion: "BORRADOR_EDITAR_MASIVO",
            agente_id: agentId,
            fecha: fecha,
            agente_tip: meta.tip || entry.agente_tip || "",
            agente_nombre: meta.nombre || entry.agente_nombre || "",
            agente_apellido1: meta.apellido1 || entry.agente_apellido1 || "",
            agente_apellido2: meta.apellido2 || entry.agente_apellido2 || "",
            empleo_nombre: meta.empleo || entry.empleo_nombre || "—",
            datos_anteriores:
              entry.datos_anteriores &&
              typeof entry.datos_anteriores === "object"
                ? entry.datos_anteriores
                : {},
            datos_nuevos: {
              turno_id: payload.turno_id,
              actividad_ids: payload.actividad_ids || [],
              observaciones: payload.observaciones || null,
            },
            detalle: "Desglose de cambio masivo por agente y fecha",
          });
        });
      });
    });

    return expanded;
  }

  function getTurnoById(turnoId) {
    var id = Number(turnoId);
    if (!id) return null;
    var turnos = (app.asignacionesState.meta && app.asignacionesState.meta.turnos) || [];
    return turnos.find(function (t) { return Number(t.id_turno) === id; }) || null;
  }

  function getActividadById(actId) {
    var id = Number(actId);
    if (!id) return null;
    var acts = (app.asignacionesState.meta && app.asignacionesState.meta.actividades) || [];
    return acts.find(function (a) { return Number(a.id_actividad) === id; }) || null;
  }

  // Devuelve un string de color legible: si el fondo es oscuro, texto blanco; si claro, negro.
  function colorContrast(hex) {
    if (!hex || hex === "none") return "#000";
    var c = hex.replace("#", "");
    if (c.length === 3) c = c[0]+c[0]+c[1]+c[1]+c[2]+c[2];
    var r = parseInt(c.substring(0,2),16);
    var g = parseInt(c.substring(2,4),16);
    var b = parseInt(c.substring(4,6),16);
    var lum = (0.299*r + 0.587*g + 0.114*b);
    return lum > 145 ? "#222" : "#fff";
  }

  // Formatea los datos de una celda de día como HTML con badges de color.
  function formatHistorialDayEntry(data) {
    if (!data || typeof data !== "object") return "—";
    var html = "";

    // Turno: badge de color + código · nombre
    var turno = getTurnoById(data.turno_id);
    if (turno) {
      var bg = turno.color || "#6c757d";
      var fg = colorContrast(bg);
      var codigo = turno.codigo || ("#" + turno.id_turno);
      var nombre = turno.nombre || "";
      html += '<span style="display:inline-block;background:' + bg + ';color:' + fg +
        ';border-radius:3px;padding:1px 5px;font-size:.7rem;font-weight:600;white-space:nowrap;margin-bottom:2px">' +
        app.escapeHtml(codigo) + "</span>" +
        (nombre ? ' <span style="font-size:.7rem">' + app.escapeHtml(nombre) + "</span>" : "");
    } else if (data.turno_id) {
      html += '<span style="font-size:.7rem;color:#888">#' + Number(data.turno_id) + "</span>";
    } else {
      html += '<span style="color:#aaa">—</span>';
    }

    // Actividades: badge de color + nombre
    var actIds = normalizeActividadIds(data.actividad_ids);
    if (actIds.length) {
      actIds.forEach(function (id) {
        var act = getActividadById(id);
        if (act) {
          var abg = act.color || "#adb5bd";
          var afg = colorContrast(abg);
          var acodigo = act.codigo || ("#" + id);
          var anombre = act.nombre || "";
          html += '<br><span style="display:inline-block;background:' + abg + ';color:' + afg +
            ';border-radius:3px;padding:0px 4px;font-size:.67rem;white-space:nowrap;margin-top:1px">' +
            app.escapeHtml(acodigo) + "</span>" +
            (anombre ? ' <span style="font-size:.67rem">' + app.escapeHtml(anombre) + "</span>" : "");
        } else {
          html += '<br><span style="font-size:.67rem;color:#888">#' + id + "</span>";
        }
      });
    }

    return html || "—";
  }

  // Devuelve el valor a mostrar en la columna de un día concreto para un lado (before/after).
  // — Para entradas masivas: datos_X.fechas[dateKey]
  // — Para entradas individuales: usa entry.fecha
  // Retorna null si esa fecha no forma parte de la operación.
  function getHistorialDayValue(entry, dateKey, side) {
    var datos = side === "before" ? entry.datos_anteriores : entry.datos_nuevos;
    if (!datos || typeof datos !== "object") return null;

    if (datos.fechas && typeof datos.fechas === "object") {
      if (!(dateKey in datos.fechas)) return null;
      var dayData = datos.fechas[dateKey];
      // null explícito → la fecha era nueva, no había dato anterior
      if (dayData === null) return side === "before" ? "—" : null;
      return formatHistorialDayEntry(dayData);
    }

    // Entrada individual: compara con la fecha del registro DB
    var entryFecha = normalizeDateKey(entry.fecha);
    if (entryFecha !== dateKey) return null;
    return formatHistorialDayEntry(datos);
  }

  // Construye los pares de filas Tabulator (Anterior / Posterior) directamente desde
  // los logs de BD, sin necesitar expansión previa.
  // — Cada fila de BD → 2 filas Tabulator (before + after)
  // — Agrupadas por agente, ordenadas por created_at DESC (par más reciente = pair_idx más bajo)
  function buildHistorialRows(logs, planningDays) {
    // Ordenar por created_at DESC; tie-break por id DESC
    var sorted = (logs || []).slice().sort(function (a, b) {
      var tA = new Date(a.created_at || 0).getTime();
      var tB = new Date(b.created_at || 0).getTime();
      if (tB !== tA) return tB - tA;
      return Number(b.id || 0) - Number(a.id || 0);
    });

    var rows = [];
    sorted.forEach(function (entry, pairIdx) {
      var agentName =
        [entry.agente_apellido1, entry.agente_apellido2, entry.agente_nombre]
          .filter(Boolean)
          .join(" ") || "Acción global";

      var beforeRow = {
        id: "before-" + entry.id + "-" + pairIdx,
        row_type: "before",
        pair_idx: pairIdx,
        row_order: 1,
        estado: "Anterior",
        log_id: Number(entry.id || 0),
        tip: entry.agente_tip || "",
        agente: agentName,
        empleo: entry.empleo_nombre || "—",
        accion: getHistorialActionLabel(entry.accion),
        usuario: entry.usuario_nombre || "Usuario #" + entry.usuario_id,
        cambio_datetime: formatHistorialDate(entry.created_at, true),
        agente_group: agentName,
      };

      var afterRow = {
        id: "after-" + entry.id + "-" + pairIdx,
        row_type: "after",
        pair_idx: pairIdx,
        row_order: 2,
        estado: "Posterior",
        log_id: Number(entry.id || 0),
        tip: "",
        agente: "",
        empleo: "",
        accion: "",
        usuario: "",
        cambio_datetime: "",
        agente_group: agentName,
      };

      planningDays.forEach(function (d) {
        var bv = getHistorialDayValue(entry, d.key, "before");
        var av = getHistorialDayValue(entry, d.key, "after");
        if (bv !== null) beforeRow["dia_" + d.key] = bv;
        if (av !== null) afterRow["dia_" + d.key] = av;
      });

      rows.push(beforeRow, afterRow);
    });

    return rows;
  }

  function buildHistorialDiffLines(entry) {
    var before =
      entry &&
      entry.datos_anteriores &&
      typeof entry.datos_anteriores === "object"
        ? entry.datos_anteriores
        : null;
    var after =
      entry && entry.datos_nuevos && typeof entry.datos_nuevos === "object"
        ? entry.datos_nuevos
        : null;
    var lines = [];

    if (before && after) {
      var keys = Array.from(
        new Set(Object.keys(before).concat(Object.keys(after))),
      );
      keys.forEach(function (key) {
        var prev = normalizeHistorialValue(before[key]);
        var next = normalizeHistorialValue(after[key]);
        if (prev !== next) lines.push(key + ": " + prev + " -> " + next);
      });
    } else if (after) {
      Object.keys(after).forEach(function (key) {
        lines.push(key + ": " + normalizeHistorialValue(after[key]));
      });
    } else if (before) {
      Object.keys(before).forEach(function (key) {
        lines.push(key + ": " + normalizeHistorialValue(before[key]));
      });
    }

    return lines;
  }

  function groupHistorialByAgent(logs) {
    return (logs || []).reduce(function (acc, entry) {
      var agentName =
        [entry.agente_apellido1, entry.agente_apellido2, entry.agente_nombre]
          .filter(Boolean)
          .join(" ") || "Acciones globales del cuadrante";
      if (!acc[agentName]) acc[agentName] = [];
      acc[agentName].push(entry);
      return acc;
    }, {});
  }

  function renderHistorialResumen(total, filters) {
    var resumenEl = document.getElementById("asigHistorialResumen");
    var subtitleEl = document.getElementById("asigHistorialModalSubtitulo");
    if (!resumenEl) return;
    if (subtitleEl) {
      subtitleEl.textContent =
        filters.nombreBorrador +
        " · " +
        filters.periodo.anio +
        "/" +
        String(filters.periodo.mes).padStart(2, "0");
    }
    resumenEl.innerHTML =
      '<div class="d-flex flex-wrap gap-2">' +
      '<span class="badge bg-light text-dark border"><strong>Agentes:</strong> ' +
      filters.agentIds.length +
      "</span>" +
      '<span class="badge bg-light text-dark border"><strong>Borrador:</strong> ' +
      app.escapeHtml(filters.nombreBorrador) +
      "</span>" +
      '<span class="badge bg-primary text-white"><strong>Cambios:</strong> ' +
      total +
      "</span>" +
      "</div>";
  }

  function getHistorialFechasText(entry) {
    var datos = entry.datos_nuevos;
    if (datos && typeof datos === "object" && datos.fechas && typeof datos.fechas === "object") {
      var keys = Object.keys(datos.fechas).sort();
      if (keys.length) {
        var formatted = keys.map(function (k) {
          return formatHistorialDate(k, false);
        });
        return formatted.join(", ");
      }
    }
    return entry.fecha
      ? formatHistorialDate(String(entry.fecha).slice(0, 10), false)
      : "—";
  }

  function renderHistorialContent(logs, filters) {
    var contentEl = document.getElementById("asigHistorialContent");
    if (!contentEl) return;
    contentEl.innerHTML = "";
    if (!logs.length) {
      contentEl.innerHTML =
        '<div class="text-center text-muted py-4">No hay cambios registrados para los agentes seleccionados.</div>';
      return;
    }

    var planningDays = (
      filters && Array.isArray(filters.fechas) ? filters.fechas : []
    ).map(function (key, idx) {
      var dt = new Date(key + "T00:00:00");
      var weekday = WEEKDAY_SHORT[idx % 7] || "";
      return {
        key: key,
        label:
          weekday +
          " " +
          String(dt.getDate()).padStart(2, "0") +
          "/" +
          String(dt.getMonth() + 1).padStart(2, "0"),
      };
    });

    // Ordenar logs por agente (nombre) ASC, luego created_at DESC dentro de cada agente
    var sorted = (logs || []).slice().sort(function (a, b) {
      var nameA = [a.agente_apellido1, a.agente_apellido2, a.agente_nombre].filter(Boolean).join(" ");
      var nameB = [b.agente_apellido1, b.agente_apellido2, b.agente_nombre].filter(Boolean).join(" ");
      var nameCmp = nameA.localeCompare(nameB, "es", { sensitivity: "base" });
      if (nameCmp !== 0) return nameCmp;
      var tA = new Date(a.created_at || 0).getTime();
      var tB = new Date(b.created_at || 0).getTime();
      if (tB !== tA) return tB - tA;
      return Number(b.id || 0) - Number(a.id || 0);
    });

    // Construir HTML de la tabla directamente — orden garantizado sin depender de Tabulator sort
    var FIXED_COLS = ["Estado", "TIP", "Agente", "Empleo", "Accción", "Usuario", "Fecha/Hora cambio"];
    var FIXED_W    = ["80px",  "72px", "180px",  "130px",  "150px",  "130px",  "155px"];

    var stickyStyle = "position:sticky;left:0;z-index:2;background:inherit;";
    var thBase = "white-space:nowrap;font-size:.75rem;padding:3px 6px;border:1px solid #dee2e6;";

    var html = '<div style="overflow-x:auto;max-height:52vh;overflow-y:auto;">';
    html += '<table class="table table-sm table-bordered mb-0" style="border-collapse:separate;border-spacing:0;font-size:.78rem;">';

    // ── THEAD ──
    html += "<thead><tr>";
    FIXED_COLS.forEach(function (col, i) {
      html += '<th style="' + thBase + 'min-width:' + FIXED_W[i] + ';background:#f8f9fa;">' + col + "</th>";
    });
    planningDays.forEach(function (d) {
      html += '<th style="' + thBase + 'min-width:78px;max-width:90px;text-align:center;background:#f8f9fa;">' + app.escapeHtml(d.label) + "</th>";
    });
    html += "</tr></thead><tbody>";

    // ── TBODY: par de filas por cada entrada de log, agrupadas por agente ──
    var lastAgentName = null;
    sorted.forEach(function (entry) {
      var agentName = [entry.agente_apellido1, entry.agente_apellido2, entry.agente_nombre]
        .filter(Boolean).join(" ") || "Acción global";

      // Cabecera de grupo cuando cambia de agente
      if (agentName !== lastAgentName) {
        lastAgentName = agentName;
        var totalCols = FIXED_COLS.length + planningDays.length;
        html += '<tr style="background:#e9ecef;">' +
          '<td colspan="' + totalCols + '" style="font-size:.78rem;padding:3px 8px;font-weight:600;border:1px solid #dee2e6;">' +
          app.escapeHtml(agentName) + " · " + app.escapeHtml(entry.agente_tip || "") +
          " · " + app.escapeHtml(entry.empleo_nombre || "—") +
          "</td></tr>";
      }

      var accion  = getHistorialActionLabel(entry.accion);
      var usuario = entry.usuario_nombre || "Usuario #" + entry.usuario_id;
      var fechaHora = formatHistorialDate(entry.created_at, true);

      var tdBase = "padding:3px 5px;border:1px solid #dee2e6;vertical-align:top;white-space:nowrap;";
      var tdDay  = "padding:3px 4px;border:1px solid #dee2e6;vertical-align:top;font-size:.72rem;max-width:90px;white-space:normal;line-height:1.2;text-align:center;";

      // Fila ANTERIOR
      html += '<tr style="background:#fff5f5;">';
      html += '<td style="' + tdBase + 'font-weight:600;color:#c0392b;">Anterior</td>';
      html += '<td style="' + tdBase + '">' + app.escapeHtml(entry.agente_tip || "") + "</td>";
      html += '<td style="' + tdBase + '">' + app.escapeHtml(agentName) + "</td>";
      html += '<td style="' + tdBase + '">' + app.escapeHtml(entry.empleo_nombre || "—") + "</td>";
      html += '<td style="' + tdBase + '">' + app.escapeHtml(accion) + "</td>";
      html += '<td style="' + tdBase + '">' + app.escapeHtml(usuario) + "</td>";
      html += '<td style="' + tdBase + '">' + app.escapeHtml(fechaHora) + "</td>";
      planningDays.forEach(function (d) {
        var val = getHistorialDayValue(entry, d.key, "before");
        html += '<td style="' + tdDay + '">' +
          (val && val !== "—" ? val : '<span style="color:#aaa">—</span>') +
          "</td>";
      });
      html += "</tr>";

      // Fila POSTERIOR
      html += '<tr style="background:#f0faf0;border-top:1px dashed #a8d5b5;">';
      html += '<td style="' + tdBase + 'font-weight:600;color:#1a7a3c;">Posterior</td>';
      html += '<td style="' + tdBase + '"></td>';
      html += '<td style="' + tdBase + '"></td>';
      html += '<td style="' + tdBase + '"></td>';
      html += '<td style="' + tdBase + '"></td>';
      html += '<td style="' + tdBase + '"></td>';
      html += '<td style="' + tdBase + '"></td>';
      planningDays.forEach(function (d) {
        var val = getHistorialDayValue(entry, d.key, "after");
        html += '<td style="' + tdDay + '">' +
          (val ? val : '<span style="color:#aaa">—</span>') +
          "</td>";
      });
      html += "</tr>";
    });

    html += "</tbody></table></div>";
    contentEl.innerHTML = html;
  }

  function getHistorialActionLabel(action) {
    var labels = {
      BORRADOR_CREAR: "Alta en borrador",
      BORRADOR_EDITAR: "Edición en borrador",
      BORRADOR_CREAR_MASIVO: "Alta masiva",
      BORRADOR_EDITAR_MASIVO: "Edición masiva",
      BORRADOR_BULK: "Asignación masiva",
      BORRADOR_ELIMINAR: "Eliminación en borrador",
      BORRADOR_COPIAR_MES: "Copia de mes",
      BORRADOR_ELIMINADO: "Borrador eliminado",
      VALIDAR: "Validación",
      REVALIDAR: "Revalidación",
    };
    return labels[action] || action || "Cambio";
  }

  async function loadAsignacionesHistorial() {
    var filters = getHistorialFilters();
    var uiFilters = getHistorialUiFilters();
    if (!filters.periodo.anio || !filters.periodo.mes) {
      showAlert("Selecciona primero el período del cuadrante.", "warning");
      return;
    }
    if (!filters.agentIds.length) {
      showAlert(
        "Marca al menos un agente en la tabla para consultar el historial.",
        "warning",
      );
      return;
    }
    if (!filters.borradorId) {
      showAlert(
        "Selecciona un borrador para consultar el historial exacto del cuadrante.",
        "warning",
      );
      return;
    }

    var contentEl = document.getElementById("asigHistorialContent");
    var pdfBtn = document.getElementById("btnAsigHistorialPdf");
    if (!contentEl) return;

    contentEl.innerHTML =
      '<div class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2" role="status"></div>Cargando historial...</div>';
    renderHistorialResumen(0, filters);
    if (pdfBtn) pdfBtn.disabled = true;

    try {
      var queryString = buildHistorialQueryString(uiFilters);
      var response = await fetch("/api/asignaciones/historial?" + queryString, {
        headers: headers(),
      });
      if (!response.ok)
        throw new Error("No se pudo cargar el historial del cuadrante");
      var data = await response.json();
      var logs = Array.isArray(data.logs) ? data.logs : [];
      var total = Number(data.total || 0);

      var dateSourceLogs =
        Array.isArray(app.asignacionesState.historialDateSourceLogs) &&
        app.asignacionesState.historialDateSourceLogs.length
          ? app.asignacionesState.historialDateSourceLogs
          : logs;

      app.asignacionesState.historialLogs = logs;
      renderHistorialResumen(total, filters);
      populateHistorialUsers(logs);
      populateHistorialDates(dateSourceLogs);
      renderHistorialContent(logs, filters);
      if (pdfBtn) {
        pdfBtn.disabled = !logs.length;
        pdfBtn.dataset.query = queryString;
      }
    } catch (error) {
      contentEl.innerHTML =
        '<div class="alert alert-danger mb-0">' +
        app.escapeHtml(error.message || "Error al cargar historial") +
        "</div>";
      if (pdfBtn) {
        pdfBtn.disabled = true;
        delete pdfBtn.dataset.query;
      }
    }
  }

  async function openAsignacionesHistorialModal() {
    var filters = getHistorialFilters();
    if (!filters.agentIds.length) {
      showAlert(
        "Marca al menos un agente en la tabla para consultar el historial.",
        "warning",
      );
      return;
    }
    var modalEl = document.getElementById("modalHistorialAsignaciones");
    if (!modalEl) return;
    ensureHistorialFilterControls();
    resetHistorialUiFilters();
    app.asignacionesState.historialDateSourceLogs = [];
    if (!modalEl.dataset.historialShownBound) {
      modalEl.dataset.historialShownBound = "1";
      modalEl.addEventListener("hide.bs.modal", function () {
        if (document.activeElement && modalEl.contains(document.activeElement)) {
          document.activeElement.blur();
        }
      });
    }
    bootstrap.Modal.getOrCreateInstance(modalEl).show();
    // No cargamos automáticamente — el usuario pulsa «Consultar»
    var contentEl = document.getElementById("asigHistorialContent");
    if (contentEl) {
      contentEl.innerHTML = '<div class="text-center text-muted py-4">Selecciona los filtros y pulsa <strong>Consultar</strong> para cargar el historial.</div>';
    }
    var pdfBtn = document.getElementById("btnAsigHistorialPdf");
    if (pdfBtn) pdfBtn.disabled = true;
    renderHistorialResumen(0, getHistorialFilters());
    updateHistorialApplyButtonState();
    await preloadAsignacionesHistorialFilterOptions();
  }

  function buildServiciosMap(serviciosRows, keyField) {
    const map = new Map();
    (serviciosRows || []).forEach(function (s) {
      const key = Number(s[keyField]);
      if (!map.has(key)) map.set(key, []);
      map.get(key).push({
        id: Number(s.actividad_id),
        label: s.actividad_codigo || s.actividad_nombre || "#" + s.actividad_id,
      });
    });
    return map;
  }

  // Refactor: Acualizacion de una unica celda 202060404 FPM 17:20
  // ★ REFACTOR: Actualizar el state local con la respuesta del upsert
  function updateStateFromUpsert(asignacion) {
    var cuadrante = app.asignacionesState.cuadrante;
    if (!cuadrante) return;

    var agenteId = Number(asignacion.agente_id);
    var fecha = String(asignacion.fecha).slice(0, 10);

    // Actualizar array de borrador
    if (cuadrante.borrador) {
      var idx = -1;
      for (var i = 0; i < cuadrante.borrador.length; i++) {
        if (
          Number(cuadrante.borrador[i].agente_id) === agenteId &&
          String(cuadrante.borrador[i].fecha).slice(0, 10) === fecha
        ) {
          idx = i;
          break;
        }
      }
      if (idx >= 0) {
        cuadrante.borrador[idx] = asignacion;
      } else {
        cuadrante.borrador.push(asignacion);
      }
    }

    // Actualizar array de servicios del borrador
    if (cuadrante.borradorServicios) {
      cuadrante.borradorServicios = cuadrante.borradorServicios.filter(
        function (s) {
          return Number(s.asignacion_borrador_id) !== Number(asignacion.id);
        },
      );
      (asignacion.servicios || []).forEach(function (s) {
        cuadrante.borradorServicios.push({
          asignacion_borrador_id: asignacion.id,
          actividad_id: s.actividad_id,
          actividad_codigo: s.actividad_codigo,
          actividad_nombre: s.actividad_nombre,
        });
      });
    }
  }

  // ★ REFACTOR: Actualizar solo la celda Tabulator modificada sin re-render completo
  function updateCell(asignacion) {
    var agenteId = Number(asignacion.agente_id);
    var fecha = String(asignacion.fecha).slice(0, 10);

    // 1. Actualizar el state
    updateStateFromUpsert(asignacion);

    // Tabulator-only flow: update row data directly without DOM manipulation.
    if (!asigTabulator) return;

    var rows = asigTabulator.getRows();
    var row = null;
    for (var ri = 0; ri < rows.length; ri++) {
      if (Number(rows[ri].getData().agente_id) === agenteId) {
        row = rows[ri];
        break;
      }
    }
    if (!row) return;

    var tCode = asignacion.turno_codigo || "";
    var tName = asignacion.turno_nombre || "";
    var tLabel = tName ? tCode + " · " + tName : tCode || "-";
    var tColor = asignacion.turno_color || "#6c757d";
    var tServs = asignacion.servicios || [];
    // Map to {id, label} format expected by the Tabulator day-column formatter.
    var tServsMapped = tServs.map(function (s) {
      return {
        id: Number(s.actividad_id),
        label: s.actividad_codigo || s.actividad_nombre || "#" + s.actividad_id,
      };
    });
    var tObs = asignacion.observaciones || "";
    var updateObj = {};
    updateObj["dia_" + fecha] = {
      asignacionId: asignacion.id || null,
      turnoLabel: tLabel,
      turnoColor: tColor,
      turno_id: Number(asignacion.turno_id),
      servicios: tServsMapped,
      actividad_ids: tServs.map(function (s) {
        return Number(s.actividad_id);
      }),
      observaciones: tObs || null,
      revision: asignacion.revision != null ? Number(asignacion.revision) : null,
    };
    row.update(updateObj);
  }
  function attachSelectFilter(inputEl, selectEl) {
    if (!inputEl || !selectEl) return;
    inputEl.addEventListener("input", function () {
      var term = normalizeSearchText(inputEl.value);
      for (var i = 0; i < selectEl.options.length; i++) {
        var opt = selectEl.options[i];
        var text = normalizeSearchText(opt.text);
        opt.style.display = text.indexOf(term) !== -1 ? "" : "none";
      }
    });
  }

  function ensureConfirmBorradorModal() {
    var existing = document.getElementById("asigConfirmDeleteBorradorModal");
    if (existing) return existing;

    var wrapper = document.createElement("div");
    wrapper.innerHTML =
      '<div class="modal fade" id="asigConfirmDeleteBorradorModal" tabindex="-1" aria-labelledby="asigConfirmDeleteBorradorLabel" aria-hidden="true">' +
      '<div class="modal-dialog">' +
      '<div class="modal-content shadow">' +
      '<div class="modal-header" style="background: #dc3545; color: #fff; border-bottom: 1px solid #dc3545;">' +
      '<h5 class="modal-title" id="asigConfirmDeleteBorradorLabel"><i class="bi bi-exclamation-triangle me-2"></i>Confirmar eliminación</h5>' +
      '<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>' +
      "</div>" +
      '<div class="modal-body">' +
      '<div class="alert alert-warning mb-3"><strong>Atención:</strong> Para eliminar este borrador, todas las celdas deben estar vacías. ' +
      "Esta acción no se puede deshacer!</div>" +
      '<p class="mb-1"><strong>Borrador:</strong></p>' +
      '<div id="asigConfirmBorradorNombre" class="mb-3 p-2 bg-light rounded border" style="font-size:.95rem;"></div>' +
      '<p class="text-muted mb-0" style="font-size:.9rem;">¿Desea continuar con la eliminación?</p>' +
      "</div>" +
      '<div class="modal-footer d-flex justify-content-between align-items-center">' +
      '<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>' +
      '<button type="button" class="btn btn-danger" id="btnConfirmDeleteBorrador"><i class="bi bi-trash me-1"></i>Eliminar</button>' +
      "</div>" +
      "</div>" +
      "</div>" +
      "</div>";
    document.body.appendChild(wrapper.firstChild);
    var modal = document.getElementById("asigConfirmDeleteBorradorModal");
    makeModalDraggable(modal);
    return modal;
  }

  function ensureAsignacionCellModal() {
    var existing = document.getElementById("asigCellModal");
    if (existing) {
      existing.parentNode.removeChild(existing);
    }
    // Obliga a recrear el modal para evitar problemas de estado interno al editar varias celdas seguidas --
    // Modal para asignar acividades/Servicios a una celda (agente + día)
    var wrapper = document.createElement("div");
    wrapper.innerHTML = `
      <div class="modal fade" id="asigCellModal" tabindex="-1" aria-labelledby="asigCellModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
          <div class="modal-content shadow">
            <div class="modal-header" style="background: var(--primary-gc-color); color: #fff; border-bottom: 1px solid var(--primary-gc-color);">
              <h5 class="modal-title" id="asigCellModalLabel"><i class="bi bi-calendar2-week me-2"></i>Editar asignación</h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
              <div id="asigCellContext" class="text-muted mb-3" style="font-size:.98rem"></div>
              <div class="row g-2">
