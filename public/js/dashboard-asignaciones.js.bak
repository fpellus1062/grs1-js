// --- Estilos para cuadrícula de fechas en el modal de borrado ---
const styleId = "asig-delete-date-grid-style";
if (!document.getElementById(styleId)) {
  const style = document.createElement("style");
  style.id = styleId;
  style.textContent = `
.delete-date-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr); /* 7 columnas */
  grid-template-rows: repeat(4, 1fr);    /* 4 filas fijas */
  gap: 2px;
  margin-bottom: 4px;
  max-width: 350px; /* controla tamaño total */
}

.delete-date-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;

  aspect-ratio: 1 / 1;  /* 🔥 clave para que sean cuadradas */
  width: 100%;

  font-size: 0.85rem;
  border: 1px solid #e0e0e0;
  border-radius: 4px;
  background: #f8f9fa;
  cursor: pointer;
  transition: background 0.2s;
}
    .delete-date-cell input[type="checkbox"] {
      margin-bottom: 2px;
    }
    .delete-date-cell.empty {
      border: none;
      background: transparent;
      pointer-events: none;
    }
    .delete-date-cell input[type="checkbox"]:checked + span,
    .delete-date-cell input[type="checkbox"]:checked {
      background: #ffe082;
    }
  `;
  document.head.appendChild(style);
}

// Renderiza las fechas visibles del cuadrante en el modal de borrado como cuadrícula 4x7 con encabezado de días
function renderDeleteDateOptions(anio, mes) {
  const container = document.getElementById("asigDeleteDates");
  const summary = document.getElementById("asigDeleteDatesSummary");
  if (!container) return;

  const planningDays = getPlanningWindow(anio, mes);
  const rows = 4;
  const cols = 7;

  // Encabezado de días de la semana (fuera del grid)
  let header = '<div class="d-flex gap-1 mb-1">';
  for (let c = 0; c < cols; c++) {
    header += `<div class="delete-date-cell fw-bold text-center" style="background:#e3e6ea;">${WEEKDAY_SHORT[c]}</div>`;
  }
  header += "</div>";

let html = '<div class="delete-date-grid">';

for (let i = 0; i < 28; i++) {
  if (i < planningDays.length) {
    const day = planningDays[i];
    const weekend = day.weekdayIndex >= 5;

    html += `<label class="delete-date-cell" style="background:${weekend ? "#d8f0ca" : "#b1d0f0"}">
      <input class="form-check-input mb-1 asig-delete-date-check"
             type="checkbox"
             value="${app.escapeHtml(day.key)}"
             data-dia="${day.dia}">
      <div class="fw-semibold" style="font-size:.72rem">
        ${app.escapeHtml(day.label)}
      </div>
      <div style="font-size:.7rem">
        ${app.escapeHtml(day.labelDate)}
      </div>
    </label>`;
  } else {
    html += '<span class="delete-date-cell empty"></span>';
  }
}

html += '</div>';
  container.innerHTML = header + html;

  function updateSummary() {
    const checked = container.querySelectorAll(
      ".asig-delete-date-check:checked",
    ).length;
    if (summary) {
      summary.textContent = checked
        ? "Fechas seleccionadas: " + checked
        : "Seleccione una o varias fechas visibles del cuadrante.";
    }
  }

  container
    .querySelectorAll(".asig-delete-date-check")
    .forEach(function (input) {
      input.addEventListener("change", updateSummary);
    });
  updateSummary();
}

function mesStringToNumber(value) {
  var MONTHS_LOCAL = [
    "Enero",
    "Febrero",
    "Marzo",
    "Abril",
    "Mayo",
    "Junio",
    "Julio",
    "Agosto",
    "Septiembre",
    "Octubre",
    "Noviembre",
    "Diciembre",
  ];
  function normalizeMonthText(v) {
    return String(v || "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim();
  }

  var raw = String(value || "").trim();
  if (!raw) return NaN;
  var asNum = Number(raw);
  if (Number.isInteger(asNum) && asNum >= 1 && asNum <= 12) return asNum;

  var norm = normalizeMonthText(raw);
  for (var i = 0; i < MONTHS_LOCAL.length; i++) {
    if (normalizeMonthText(MONTHS_LOCAL[i]) === norm) return i + 1;
  }
  return NaN;
}

function mesNumberToString(mes) {
  var MONTHS_LOCAL = [
    "Enero",
    "Febrero",
    "Marzo",
    "Abril",
    "Mayo",
    "Junio",
    "Julio",
    "Agosto",
    "Septiembre",
    "Octubre",
    "Noviembre",
    "Diciembre",
  ];
  var n = Number(mes);
  if (!Number.isInteger(n) || n < 1 || n > 12) return "";
  return MONTHS_LOCAL[n - 1];
}
