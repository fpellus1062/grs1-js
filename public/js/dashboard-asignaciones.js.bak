      "</div>";
    document.body.appendChild(wrapper.firstChild);
    var modal = document.getElementById("asigCopyModal");
    makeModalDraggable(modal);
    return modal;
  }

  function fillAgenteOptions(selectEl, options) {
    if (!selectEl) return;
    const opts = options || {};
    const onlySelectedForBulk = !!opts.onlySelectedForBulk;
    const preselectSelected = !!opts.preselectSelected;
    const selectedIds = new Set(
      (app.asignacionesState.selectedAgenteIdsVista || [])
        .concat(app.globalState.selectedAgenteIdsForBulk || [])
        .map(Number)
        .filter(function (id) {
          return Number.isFinite(id) && id > 0;
        }),
    );
    var agentes = app.asignacionesState.meta?.agentes || [];

    if (onlySelectedForBulk) {
      agentes = agentes.filter(function (a) {
        return selectedIds.has(Number(a.id_agente));
      });
    }

    selectEl.innerHTML = agentes
      .map(function (a) {
        const id = Number(a.id_agente);
        const label = (a.tip ? a.tip + " · " : "") + agenteNombre(a);
        return (
          '<option value="' +
          id +
          '">' +
          app.escapeHtml(label || "Agente #" + id) +
          "</option>"
        );
      })
      .join("");

    if (opts.preselectAll) {
      for (var i = 0; i < selectEl.options.length; i++) {
        selectEl.options[i].selected = true;
      }
    } else if (preselectSelected) {
      for (var j = 0; j < selectEl.options.length; j++) {
        var optId = Number(selectEl.options[j].value);
        selectEl.options[j].selected = selectedIds.has(optId);
      }
    }

    if (opts.hintEl) {
      if (onlySelectedForBulk && !agentes.length) {
        opts.hintEl.textContent =
          "No hay agentes marcados en la vista de cuadrante.";
      } else if (onlySelectedForBulk) {
        opts.hintEl.textContent =
          "Se muestran " + agentes.length + " agente(s) seleccionados.";
      } else {
        opts.hintEl.textContent = "";
      }
    }
  }

  function fillTurnosOptions(selectEl, selectedId) {
    if (!selectEl) return;
    const turnos = app.asignacionesState.meta?.turnos || [];
    selectEl.innerHTML =
      '<option value="">Seleccione turno...</option>' +
      turnos
        .map(function (t) {
          const id = Number(t.id_turno);
          const selected = Number(selectedId) === id ? " selected" : "";
          const label = (t.codigo || "") + " · " + (t.nombre || "");
          return (
            '<option value="' +
            id +
            '"' +
            selected +
            ">" +
            app.escapeHtml(label.trim()) +
            "</option>"
          );
        })
        .join("");
  }

  function fillActividadesOptions(selectEl, selectedIds) {
    if (!selectEl) return;
    const set = new Set((selectedIds || []).map(Number));
    const actividades = app.asignacionesState.meta?.actividades || [];
    selectEl.innerHTML = actividades
      .map(function (a) {
        const id = Number(a.id_actividad);
        const selected = set.has(id) ? " selected" : "";
        const label = (a.codigo || "") + " · " + (a.nombre || "");
        return (
          '<option value="' +
          id +
          '"' +
          selected +
          ">" +
          app.escapeHtml(label.trim()) +
          "</option>"
        );
      })
      .join("");
  }

  app.openAsignacionCellModal = function openAsignacionCellModal(payload) {
    // Añadir funcionalidad al checkbox "Marcar todos los días"
    setTimeout(function () {
      const checkAll = document.getElementById("asigCellCheckAllDias");
      const diaEl = document.getElementById("asigCellDia");
      if (checkAll && diaEl) {
        checkAll.onclick = function () {
          for (let i = 0; i < diaEl.options.length; i++) {
            diaEl.options[i].selected = checkAll.checked;
          }
        };
      }
    }, 0);
    const modalEl = ensureAsignacionCellModal();
    if (!modalEl) {
      alert("No se pudo crear el modal de asignación.");
      console.error("[ASIG] No se pudo crear el modal de asignación");
      return;
    } else {
      console.log("[ASIG] Modal insertado en el DOM:", modalEl);
    }
    const contextEl = document.getElementById("asigCellContext");
    const turnoEl = document.getElementById("asigCellTurno");
    const diaEl = document.getElementById("asigCellDia");
    const actividadesEl = document.getElementById("asigCellActividades");
    const obsEl = document.getElementById("asigCellObservaciones");
    const saveBtn = document.getElementById("btnSaveAsigCell");

    if (!turnoEl || !diaEl || !actividadesEl || !obsEl || !saveBtn) return;

    // Limpia cualquier evento previo para evitar duplicados
    const newSaveBtn = saveBtn.cloneNode(true);
    saveBtn.parentNode.replaceChild(newSaveBtn, saveBtn);
    const actualSaveBtn = document.getElementById("btnSaveAsigCell");

    // Restaurar el handler real asíncrono
    actualSaveBtn.onclick = async function () {
      // Log de todas las opciones del select de días
      const allOptions = Array.from(diaEl.options).map((opt) => ({
        value: opt.value,
        selected: opt.selected,
        text: opt.text,
        date: opt.getAttribute("data-date"),
      }));

      const selectedOptions = Array.from(diaEl.options).filter(
        (opt) => opt.selected,
      );
      const periodo = getPeriodo();
      const diasPayload = selectedOptions
        .map((opt) => {
          const fecha = opt.getAttribute("data-date");
          return {
            anio: periodo.anio,
            mes: periodo.mes,
            dia: 1,
            fecha,
          };
        })
        .filter((d) => d.anio && d.mes && d.fecha);

      const turnoId = Number(turnoEl.value || 0);
      const actividadIds = Array.from(actividadesEl.selectedOptions)
        .map((opt) => Number(opt.value))
        .filter(Boolean);
      if (!turnoId) {
        showAlert("Debe seleccionar un turno", "warning");
        return;
      }
      if (!actividadIds.length) {
        showAlert("Debe seleccionar al menos una actividad", "warning");
        return;
      }
      if (!diasPayload.length) {
        showAlert("Debe seleccionar al menos un día", "warning");
        return;
      }

      try {
        var upsertResults = [];

        // ★ REFACTOR: Si hay más de 1 día, usar /bulk en vez de N llamadas a /upsert
        if (diasPayload.length > 1) {
          const bulkBody = {
            anio: diasPayload[0].anio,
            mes: diasPayload[0].mes,
            borrador_id: getSelectedBorradorId(),
            agente_ids: [payload.agente_id],
            dias: diasPayload.map(function (d) {
              return d.fecha;
            }),
            turno_id: turnoId,
            actividad_ids: actividadIds,
            observaciones: obsEl.value.trim() || null,
          };
          const res = await fetch("/api/asignaciones/bulk", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + app.globalState.token,
              "X-Asig-Client-Version": ASIG_FE_VERSION,
            },
            body: JSON.stringify(bulkBody),
          });

          let responseJson = null;
          try {
            responseJson = await res.json();
          } catch (_) {
            responseJson = null;
          }

          if (res.status === 409) {
            showAlert("La celda fue modificada por otro usuario. Recargando cuadrante...", "warning");
            await app.loadAsignacionesCuadrante();
            return;
          }

          if (!res.ok || (responseJson && responseJson.ok === false)) {
            throw new Error(
              (responseJson && responseJson.message) ||
                "No se pudo guardar la asignación masiva",
            );
          }

          // Ojo aqui hemos tocado por si no funciona el bulk, revisar que el formato de respuesta es correcto y que se actualizan las celdas afectadas. Si va bien, eliminar el código de bulk y usar este formato para el upsert individual también, para unificar ambos caminos.
          var bulkTurnoMeta = null;
          var metaTurnos = (app.asignacionesState.meta || {}).turnos || [];
          for (var ti = 0; ti < metaTurnos.length; ti++) {
            if (Number(metaTurnos[ti].id_turno) === turnoId) {
              bulkTurnoMeta = metaTurnos[ti];
              break;
            }
          }
          var bulkServicios = actividadIds.map(function (actId) {
            var metaActs = (app.asignacionesState.meta || {}).actividades || [];
            for (var ai = 0; ai < metaActs.length; ai++) {
              if (Number(metaActs[ai].id_actividad) === actId) {
                return {
                  actividad_id: actId,
                  actividad_codigo: metaActs[ai].codigo || "",
                  actividad_nombre: metaActs[ai].nombre || "",
                };
              }
            }
            return {
              actividad_id: actId,
              actividad_codigo: "",
              actividad_nombre: "#" + actId,
            };
          });

          // Actualizar cada celda afectada
          for (var di = 0; di < diasPayload.length; di++) {
            updateCell({
              agente_id: payload.agente_id,
              fecha: String(diasPayload[di].fecha).slice(0, 10),
              turno_id: turnoId,
              turno_codigo: bulkTurnoMeta ? bulkTurnoMeta.codigo : "",
              turno_color: bulkTurnoMeta ? bulkTurnoMeta.color : "#6c757d",
              turno_nombre: bulkTurnoMeta ? bulkTurnoMeta.nombre : "",
              observaciones: obsEl.value.trim() || null,
              servicios: bulkServicios,
            });
          }

          showAlert(
            "Asignación guardada en borrador " +
              ASIG_FE_VERSION +
              " para " +
              diasPayload.length +
              " día(s)",
            "success",
          );
        } else {
          // ★ Un solo día: usar /upsert individual (rápido)
          var d = diasPayload[0];
          var body = {
            anio: d.anio,
            mes: d.mes,
            borrador_id: getSelectedBorradorId(),
            agente_id: payload.agente_id,
            dia: d.dia,
            fecha: d.fecha,
            turno_id: turnoId,
            actividad_ids: actividadIds,
            observaciones: obsEl.value.trim() || null,
            revision: payload.revision != null ? Number(payload.revision) : null,
          };
          var res = await fetch("/api/asignaciones/upsert", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + app.globalState.token,
              "X-Asig-Client-Version": ASIG_FE_VERSION,
            },
            body: JSON.stringify(body),
          });

          var responseJson = null;
          try {
            responseJson = await res.json();
          } catch (_) {
            responseJson = null;
          }

          if (res.status === 409) {
            showAlert("La celda fue modificada por otro usuario. Recargando cuadrante...", "warning");
            await app.loadAsignacionesCuadrante();
            return;
          }

          if (!res.ok || (responseJson && responseJson.ok === false)) {
            var message =
              responseJson && responseJson.message
                ? responseJson.message
                : "No se pudo guardar la asignación";
            if (
              responseJson &&
              Array.isArray(responseJson.details) &&
              responseJson.details.length
            ) {
              message +=
                ": " +
                (responseJson.details[0].message || "Error de validación");
            }
            throw new Error(message);
          }

          if (responseJson && responseJson.asignacion) {
            updateCell(responseJson.asignacion);
          }

          showAlert(
            "Asignación guardada en borrador " +
              ASIG_FE_VERSION +
              " para 1 día(s)",
            "success",
          );
        }

        // Cerrar el modal
        const modalEl = document.getElementById("asigCellModal");
        if (modalEl) {
          const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
          modalInstance.hide();
        }
      } catch (e) {
        showAlert(e.message, "danger");
      }
    };

    const meta = app.asignacionesState.meta || {};
    const turnos = meta.turnos || [];
    const actividades = meta.actividades || [];
    const p = getPeriodo();

    if (contextEl) {
      var fechaTxt =
        payload.fecha ||
        String(payload.anio) +
          "-" +
          String(payload.mes).padStart(2, "0") +
          "-" +
          String(payload.dia).padStart(2, "0");
      contextEl.textContent =
        "Agente: " +
        (payload.agenteNombre || "#" + payload.agente_id) +
        "  |  Fecha: " +
        fechaTxt +
        "  |  Período: " +
        p.anio +
        "/" +
        String(p.mes).padStart(2, "0");
    }

    // Siempre usar el periodo de la cabecera del cuadrante
    //Modal de Asignacion de Turnos y Diario de Actividades
    let planningDays = [];

    if (
      app.asignacionesState &&
      Array.isArray(app.asignacionesState.cuadranteDays)
    ) {
      planningDays = app.asignacionesState.cuadranteDays;
    } else {
      // Cogemos el periodo de la cabecera del cuadrante, no del payload, para evitar problemas si el usuario ha cambiado el periodo mientras tenía abierto el modal
      planningDays = getPlanningWindow(p.anio, p.mes);
    }
    // Seleccionar el día actual si no hay días en payload
    let diasSeleccionados = [];
    if (Array.isArray(payload.dias) && payload.dias.length) {
      diasSeleccionados = payload.dias.map(Number);
    } else if (payload.dia) {
      diasSeleccionados = [Number(payload.dia)];
    }
    diaEl.innerHTML = planningDays
      .map(function (day) {
        const selected = diasSeleccionados.includes(Number(day.dia))
          ? " selected"
          : "";
        return `<option value="${day.dia}" data-date="${day.key}" data-anio="${day.anio}" data-mes="${day.mes}"${selected}>${day.label} ${day.labelDate}</option>`;
      })
      .join("");
    // Si no hay ningún día seleccionado, seleccionar el primero por defecto
    if (!diasSeleccionados.length && diaEl.options.length > 0) {
      diaEl.options[0].selected = true;
    }

    // Mostrar los turnos como badges de color en el select
    // Restaurar select clásico de turnos con opciones
    turnoEl.innerHTML =
      '<option value="">Seleccione turno...</option>' +
      turnos
        .map(function (t) {
          const selected =
            Number(t.id_turno) === Number(payload.turno_id) ? " selected" : "";
          const label = (t.codigo || "") + " · " + (t.nombre || "");
          return (
            '<option value="' +
            t.id_turno +
            '"' +
            selected +
            ">" +
            app.escapeHtml(label.trim()) +
            "</option>"
          );
        })
        .join("");

    actividadesEl.innerHTML = actividades
      .map(function (a) {
        const id = Number(a.id_actividad);
        const selected = (payload.actividad_ids || []).includes(id)
          ? " selected"
          : "";
        const label = (a.codigo || "") + " · " + (a.nombre || "");
        return (
          '<option value="' +
          id +
          '"' +
          selected +
          ">" +
          app.escapeHtml(label.trim()) +
          "</option>"
        );
      })
      .join("");

    obsEl.value = payload.observaciones || "";

    // Filtro de búsqueda en actividades
    var filterActCell = document.getElementById("asigCellFilterActividades");
    if (filterActCell) {
      filterActCell.value = "";
      attachSelectFilter(filterActCell, actividadesEl);
    }

    try {
      bootstrap.Modal.getOrCreateInstance(modalEl).show();
    } catch (e) {
      alert("Error al mostrar el modal: " + e.message);
      console.error("[ASIG] Error al mostrar el modal:", e);
    }
  };
  // Nueva funcion que cuenta los agentes con el cuadrante completo (sin días sin asignar) y la muestra en el resumen de meta
  function countAgentesConCuadranteCompleto(data, anio, mes) {
    if (!data || !anio || !mes) return 0;

    var planningDays = getPlanningWindow(anio, mes);
    var totalDays = planningDays.length;
    if (!totalDays) return 0;

    var dayKeys = new Set(
      planningDays.map(function (d) {
        return d.key;
      }),
    );
    var isBorrador = !!(data.control && data.control.borrador_id && data.control.estado !== 'sin_borrador');
    var sourceRows = isBorrador ? (data.borrador || []) : (data.definitivo || []);

    var assignedByAgente = new Map();
    sourceRows.forEach(function (r) {
      var agenteId = normalizeAgenteId(r.agente_id);
      var fecha = r.fecha
        ? String(r.fecha).slice(0, 10)
        : String(r.anio) +
          "-" +
          String(r.mes).padStart(2, "0") +
          "-" +
          String(r.dia).padStart(2, "0");

      if (!dayKeys.has(fecha)) return;
      if (!assignedByAgente.has(agenteId))
        assignedByAgente.set(agenteId, new Set());
      assignedByAgente.get(agenteId).add(fecha);
    });

    var agentesMeta =
      (app.asignacionesState.meta && app.asignacionesState.meta.agentes) || [];
    var agenteIds = agentesMeta.length
      ? agentesMeta.map(function (a) {
          return normalizeAgenteId(a.id_agente);
        })
      : Array.from(assignedByAgente.keys());

    var completos = 0;
    agenteIds.forEach(function (agenteId) {
      var fechas = assignedByAgente.get(agenteId);
      if (fechas && fechas.size === totalDays) completos += 1;
    });

    return completos;
  }

  function countAppliedTurnosYServicios(data, anio, mes) {
    if (!data || !anio || !mes) {
      return { turnosAplicados: 0, serviciosAplicados: 0 };
    }

    var planningDays = getPlanningWindow(anio, mes);
    if (!planningDays.length) {
      return { turnosAplicados: 0, serviciosAplicados: 0 };
    }

    var dayKeys = new Set(
      planningDays.map(function (d) {
        return d.key;
      }),
    );
    var isBorrador = !!(data.control && data.control.borrador_id && data.control.estado !== 'sin_borrador');
    var sourceRows = isBorrador ? (data.borrador || []) : (data.definitivo || []);
    var serviciosByAsig = isBorrador
      ? buildServiciosMap(data.borradorServicios, "asignacion_borrador_id")
      : buildServiciosMap(data.definitivoServicios, "asignacion_id");

    var usedTurnos = new Set();
    var usedServicios = new Set();

    sourceRows.forEach(function (r) {
      var fecha = r.fecha
        ? String(r.fecha).slice(0, 10)
        : String(r.anio) +
          "-" +
          String(r.mes).padStart(2, "0") +
          "-" +
          String(r.dia).padStart(2, "0");

      if (!dayKeys.has(fecha)) return;

      var turnoId = Number(r.turno_id);
      if (turnoId) usedTurnos.add(turnoId);

      var servicios = serviciosByAsig.get(Number(r.id)) || [];
      if (servicios.length) {
        servicios.forEach(function (s) {
          var id = Number(s.id);
          if (id) usedServicios.add(id);
        });
        return;
      }

      (Array.isArray(r.actividad_ids) ? r.actividad_ids : []).forEach(
        function (id) {
          var n = Number(id);
          if (n) usedServicios.add(n);
        },
      );

      (Array.isArray(r.servicios) ? r.servicios : []).forEach(function (s) {
        var n = Number(s && (s.actividad_id || s.id));
        if (n) usedServicios.add(n);
      });
    });

    return {
      turnosAplicados: usedTurnos.size,
      serviciosAplicados: usedServicios.size,
    };
  }

  //Cambio para mostrar el número de agentes con cuadrante completo en el resumen de meta
  function renderMetaResumen(meta, extras) {
    const el = document.getElementById("asigMetaResumen");
    if (!el) return;

    const safe = function (n) {
      return Number(n || 0);
    };
    const extra = extras || {};
    const totalAgentes = safe(meta?.agentes?.length);
    const agentesMarcados = safe(extra.agentesMarcados);
    const cards = [
      {
        label: "Agentes / Marcados",
        value: totalAgentes + " / " + agentesMarcados,
      },
      {
        label: "Agentes con cuadrante completo",
        value: safe(extra.agentesConCuadranteCompleto),
      },
      { label: "Turnos", value: safe(extra.turnosAplicados) },
      { label: "Servicios", value: safe(extra.serviciosAplicados) },
      { label: "Empleos", value: safe(meta?.empleos?.length) },
      { label: "Pelotones", value: safe(meta?.pelotones?.length) },
      { label: "Situaciones", value: safe(meta?.situaciones?.length) },
    ];

    el.innerHTML = cards
      .map(function (c) {
        return (
          '<div class="col">' +
          '<div class="border rounded p-1 bg-light">' +
          '<div class="text-muted" style="font-size:.68rem;line-height:1.1">' +
          app.escapeHtml(c.label) +
          "</div>" +
          '<div class="fw-semibold" style="font-size:.92rem;line-height:1.2">' +
          app.escapeHtml(String(c.value)) +
          "</div>" +
          "</div>" +
          "</div>"
        );
      })
      .join("");
  }

  function refreshMetaResumenFromState() {
    var meta = app.asignacionesState.meta || {};
    var extras = {
      agentesConCuadranteCompleto: 0,
      turnosAplicados: 0,
      serviciosAplicados: 0,
      agentesMarcados: (app.asignacionesState.selectedAgenteIdsVista || [])
        .length,
    };

    if (
      app.asignacionesState.cuadrante &&
      app.asignacionesState.anio &&
      app.asignacionesState.mes
    ) {
      extras.agentesConCuadranteCompleto = countAgentesConCuadranteCompleto(
        app.asignacionesState.cuadrante,
        app.asignacionesState.anio,
        app.asignacionesState.mes,
      );
      var applied = countAppliedTurnosYServicios(
        app.asignacionesState.cuadrante,
        app.asignacionesState.anio,
        app.asignacionesState.mes,
      );
      extras.turnosAplicados = applied.turnosAplicados;
      extras.serviciosAplicados = applied.serviciosAplicados;
    }

    renderMetaResumen(meta, extras);
  }

  function renderEstado(control) {
    const el = document.getElementById("asignacionesEstadoPeriodo");
    if (!el) return;

    const estado =
      control && control.estado ? String(control.estado) : "sin_borrador";
    el.className = "badge border";

    if (estado === "validado") {
      el.classList.add("bg-success-subtle", "text-success-emphasis");
    } else if (estado === "borrador" || estado === "pendiente_validacion") {
      el.classList.add("bg-warning-subtle", "text-warning-emphasis");
    } else {
      el.classList.add("bg-light", "text-dark");
    }

    el.textContent = "Estado: " + estado;
  }

  // ── Renderizado del cuadrante con Tabulator (virtual DOM) ──────────────
  // Render principal y unico del cuadrante (sin tabla HTML alternativa).
  function renderGridTabulator(data, anio, mes) {
    var container = document.getElementById("asigGridContainer");
    if (!container) return;

    // Destroy existing Tabulator instance before re-init
    if (asigTabulator) {
      asigTabulator.destroy();
      asigTabulator = null;
    }

    // Clear inline styles so Tabulator manages its own height and overflow
    container.removeAttribute("style");

    var planningDays = getPlanningWindow(anio, mes);
    app.asignacionesState.cuadranteDays = planningDays;

    // isBorrador: hay borrador activo (aunque esté vacío) → no caer en definitivo
    var isBorrador = !!(data.control && data.control.borrador_id && data.control.estado !== 'sin_borrador');
    var sourceRows = isBorrador ? (data.borrador || []) : (data.definitivo || []);
    var serviciosByAsig = isBorrador
      ? buildServiciosMap(data.borradorServicios, "asignacion_borrador_id")
      : buildServiciosMap(data.definitivoServicios, "asignacion_id");

    var agentesMap = new Map();

    // Build agents from meta
    (
      (app.asignacionesState.meta && app.asignacionesState.meta.agentes) ||
      []
    ).forEach(function (ag) {
      var agenteId = normalizeAgenteId(ag.id_agente);
      agentesMap.set(agenteId, {
        agente_id: agenteId,
        tip: ag.agente_tip || "",
        nombre: agenteNombre(ag),
        empleo_nombre: ag.empleo_nombre || "",
        color_empleo: ag.color_empleo || ag.empleo_color || "#bdbdbd",
        peloton_id: ag.peloton_id,
        peloton_codigo: ag.peloton_codigo || "",
        peloton_color: ag.peloton_color || "#888",
        situacion_id: ag.situacion_id,
        pei: !!(
          ag.pei === true ||
          ag.pei === 1 ||
          ag.pei === "true" ||
          ag.pei === "1"
        ),
        paef: !!(
          ag.paef === true ||
          ag.paef === 1 ||
          ag.paef === "true" ||
          ag.paef === "1"
        ),
        orden_gc: ag.orden_gc,
        aptitudes: Array.isArray(ag.aptitudes)
          ? ag.aptitudes
          : typeof ag.aptitudes === "string"
            ? ag.aptitudes
                .split(",")
                .map(function (s) {
                  return s.trim();
                })
                .filter(Boolean)
            : [],
        situacion: ag.situacion_nombre || ag.situacion || "",
        comentarios: ag.comentarios || "",
      });
    });

    // Also ensure any agent that appears in sourceRows is in the map
    sourceRows.forEach(function (r) {
      var agenteId = normalizeAgenteId(r.agente_id);
      if (!agentesMap.has(agenteId)) {
        agentesMap.set(agenteId, {
          agente_id: agenteId,
          tip: r.agente_tip || "",
          nombre: [r.agente_apellido1, r.agente_apellido2, r.agente_nombre]
            .filter(Boolean)
            .join(" "),
          empleo_nombre: r.empleo_nombre || "",
          color_empleo: r.color_empleo || r.empleo_color || "#bdbdbd",
          peloton_id: r.peloton_id,
          peloton_codigo: r.peloton_codigo || "",
          peloton_color: r.peloton_color || "#888",
          situacion_id: r.situacion_id,
          pei: !!(
            r.pei === true ||
            r.pei === 1 ||
            r.pei === "true" ||
            r.pei === "1"
          ),
          paef: !!(
            r.paef === true ||
            r.paef === 1 ||
            r.paef === "true" ||
            r.paef === "1"
          ),
          orden_gc: r.orden_gc,
          aptitudes: Array.isArray(r.aptitudes)
            ? r.aptitudes
            : typeof r.aptitudes === "string"
              ? r.aptitudes
                  .split(",")
                  .map(function (s) {
                    return s.trim();
                  })
                  .filter(Boolean)
              : [],
          situacion: r.situacion_nombre || "",
          comentarios: r.comentarios || "",
        });
      }
    });

    // Build día data keyed by agente_id → dia field key
    var diasData = {};
    sourceRows.forEach(function (r) {
      var agenteId = normalizeAgenteId(r.agente_id);
      var servs = serviciosByAsig.get(Number(r.id)) || [];
      var key = r.fecha
        ? String(r.fecha).slice(0, 10)
        : String(r.anio) +
          "-" +
          String(r.mes).padStart(2, "0") +
          "-" +
          String(r.dia).padStart(2, "0");
      if (!diasData[agenteId]) diasData[agenteId] = {};
      diasData[agenteId]["dia_" + key] = {
        asignacionId: Number(r.id),
        turnoLabel: getTurnoLabel(r),
        turno_id: Number(r.turno_id),
        turnoColor: r.turno_color || "#6c757d",
        servicios: servs,
        actividad_ids: servs.map(function (s) {
          return Number(s.id);
        }),
        observaciones: r.observaciones || null,
        revision: r.revision != null ? Number(r.revision) : null,
      };
    });

    // Build flat Tabulator row array
    var tabulatorData = [];
    agentesMap.forEach(function (ag) {
      var row = {
        agente_id: ag.agente_id,
        tip: ag.tip || "",
        nombre: ag.nombre || "Agente #" + ag.agente_id,
        empleo_nombre: ag.empleo_nombre,
        color_empleo: ag.color_empleo,
        peloton_codigo: ag.peloton_codigo,
        peloton_color: ag.peloton_color,
        situacion: ag.situacion,
        pei: ag.pei,
        paef: ag.paef,
        orden_gc: ag.orden_gc,
        aptitudes: ag.aptitudes,
        comentarios: ag.comentarios,
      };
      var agtDias = diasData[ag.agente_id] || {};
      planningDays.forEach(function (pd) {
        row["dia_" + pd.key] = agtDias["dia_" + pd.key] || null;
      });
      tabulatorData.push(row);
    });

    var totalAgentes = tabulatorData.length;

    // ── Fixed columns ──────────────────────────────────────────────────────
    var fixedCols = [
      {
        title:
          '<input type="checkbox" id="asigTabSelectAll" class="form-check-input" aria-label="Marcar todos los agentes visibles">',
        titleFormatter: "html",
        frozen: true,
        headerSort: false,
        hozAlign: "center",
        minWidth: 42,
        widthGrow: 0,
        formatter: function (cell) {
          var agenteId = Number(cell.getRow().getData().agente_id);
          var arr = app.asignacionesState.selectedAgenteIdsVista || [];
          var checked = arr.indexOf(agenteId) !== -1 ? " checked" : "";
          return (
            '<input type="checkbox" class="form-check-input asig-tab-row-check" data-agente-id="' +
            agenteId +
            '"' +
            checked +
            ' aria-label="Seleccionar agente">'
          );
        },
      },
      {
        title: "TIP",
        field: "tip",
        frozen: true,
        headerFilter: "input",
        headerFilterPlaceholder: "Filtrar...",
        minWidth: 60,
        sorter: "string",
      },
      {
        title: "Agente",
        field: "nombre",
        frozen: true,
        headerFilter: "input",
        headerFilterPlaceholder: "Filtrar...",
        minWidth: 140,
        sorter: "string",
        formatter: function (cell) {
          var d = cell.getRow().getData();
          var html = '<div style="line-height:1.15;">';
          html +=
            '<div class="fw-semibold">' +
            app.escapeHtml(d.nombre || "") +
            "</div>";
          var empleoSituacion = "";
          if (d.empleo_nombre) {
            empleoSituacion +=
              '<span class="badge me-1" style="background:' +
              app.escapeHtml(d.color_empleo || "#bdbdbd") +
              ';color:#fff;font-size:.68em;white-space:normal;line-height:1.1;">' +
              app.escapeHtml(d.empleo_nombre) +
              "</span>";
          }
          if (d.situacion) {
            empleoSituacion +=
              '<span class="badge bg-secondary text-light me-1" style="font-size:.70em;line-height:1.1;">' +
              app.escapeHtml(d.situacion) +
              "</span>";
          }
          if (empleoSituacion) {
            html += "<div>" + empleoSituacion + "</div>";
          }
          var extras = "";
          if (Array.isArray(d.aptitudes) && d.aptitudes.length) {
            extras += d.aptitudes
              .map(function (ap) {
                return (
                  '<span class="badge bg-info text-dark me-1" style="font-size:.70em">' +
                  app.escapeHtml(ap) +
                  "</span>"
                );
              })
              .join("");
          }
          if (d.comentarios && String(d.comentarios).trim().length > 0) {
            extras +=
              '<span class="ms-1 text-primary asig-comentario-icon" data-agente-id="' +
              d.agente_id +
              '" style="cursor:pointer;" title="Ver comentarios"><i class="bi bi-chat-dots-fill"></i></span>';
          }
          if (extras) {
            html += "<div>" + extras + "</div>";
          }
          html += "</div>";
          return html;
        },
      },
      {
        title: "Pelotón",
        field: "peloton_codigo",
        frozen: true,
        headerFilter: "input",
        headerFilterPlaceholder: "Filtrar...",
        minWidth: 65,
        sorter: "string",
        formatter: function (cell) {
          var d = cell.getRow().getData();
          if (!d.peloton_codigo) return "-";
          return (
            '<span class="badge text-light" style="background:' +
            app.escapeHtml(d.peloton_color || "#888") +
            ';font-size:.95em">' +
            app.escapeHtml(d.peloton_codigo) +
            "</span>"
          );
        },
      },
      {
        title: "PEI",
        field: "pei",
        frozen: true,
        headerFilter: "tickCross",
        headerFilterParams: { tristate: true },
        headerFilterEmptyCheck: function (v) {
          return v === null || v === undefined;
        },
        minWidth: 45,
        hozAlign: "center",
        formatter: "tickCross",
        formatterParams: {
          allowEmpty: true,
          allowTruthy: true,
          tickElement: '<i class="bi bi-check-circle-fill text-success"></i>',
          crossElement: '<i class="bi bi-x-circle-fill text-danger"></i>',
        },
      },
      {
        title: "PAEF",
        field: "paef",
        frozen: true,
        headerFilter: "tickCross",
        headerFilterParams: { tristate: true },
        headerFilterEmptyCheck: function (v) {
          return v === null || v === undefined;
        },
        minWidth: 45,
        hozAlign: "center",
        formatter: "tickCross",
        formatterParams: {
          allowEmpty: true,
          allowTruthy: true,
          tickElement: '<i class="bi bi-check-circle-fill text-success"></i>',
          crossElement: '<i class="bi bi-x-circle-fill text-danger"></i>',
        },
      },
      {
        title: "Orden",
        field: "orden_gc",
        frozen: true,
        headerFilter: "input",
        headerFilterPlaceholder: "Filtrar...",
        minWidth: 50,
        sorter: "number",
      },
    ];

    // ── Dynamic day columns ────────────────────────────────────────────────
    var dayCols = planningDays.map(function (pd) {
      var isWeekend = pd.weekdayIndex >= 5;
      var pdKey = pd.key; // captured for cellClick closure
      return {
        title:
          pd.label +
          '<br><span style="font-size:.85em">' +
          pd.labelDate +
          "</span>",
        field: "dia_" + pd.key,
        minWidth: 70,
        hozAlign: "center",
        headerSort: false,
        cssClass: isWeekend ? "asig-weekend-col" : "",
        titleFormatter: "html",
        formatter: function (cell) {
          var val = cell.getValue();
          if (!val) return '<span class="text-muted">—</span>';
          var serviciosTxt =
            val.servicios && val.servicios.length
              ? val.servicios
                  .map(function (s) {
                    return s.label;
                  })
                  .join(", ")
              : "-";
          var html = '<div class="d-flex flex-column gap-1">';
          html +=
            '<span class="badge" style="background:' +
            app.escapeHtml(val.turnoColor || "#6c757d") +
            ';color:#fff;font-size:.72rem">' +
            app.escapeHtml(val.turnoLabel || "") +
            "</span>";
          var obsIconHtml = "";
          if (
            val.observaciones &&
            String(val.observaciones).trim().length > 0
          ) {
            obsIconHtml =
              '<span class="ms-1 text-primary asig-cell-comentario-icon" data-obs="' +
              app.escapeHtml(val.observaciones) +
              '" style="cursor:pointer;" title="Ver observación"><i class="bi bi-chat-dots-fill"></i></span>';
          }
          html +=
            '<small class="text-muted" style="line-height:1.2">' +
            app.escapeHtml(serviciosTxt) +
            obsIconHtml +
            "</small>";
          html += "</div>";
          return html;
        },
        cellClick: function (e, cell) {
          // Skip if clicking the observaciones icon (handled by event delegation)
          if (
            e.target &&
            e.target.closest &&
            e.target.closest(".asig-cell-comentario-icon")
          )
            return;
          var rowData = cell.getRow().getData();
          var val = cell.getValue();
          app.openAsignacionCellModal({
            anio: pd.anio,
            mes: pd.mes,
            agente_id: rowData.agente_id,
            agenteNombre: rowData.nombre,
            dia: pd.dia,
            fecha: pdKey,
            turno_id: val ? val.turno_id : null,
            actividad_ids: val ? val.actividad_ids || [] : [],
            observaciones: val ? val.observaciones : null,
            revision: val && val.revision != null ? Number(val.revision) : null,
          });
        },
      };
    });

    // ── Initialize Tabulator ───────────────────────────────────────────────
    asigTabulator = new Tabulator("#asigGridContainer", {
      locale: "es-es",
      langs: TABULATOR_LANGS,
      layout: "fitDataFill",
      height: "calc(100vh - 320px)",
      virtualDom: true,
      data: tabulatorData,
      columnDefaults: { resizable: true, headerHozAlign: "center" },
      columns: fixedCols.concat(dayCols),
      placeholder: "No hay asignaciones para el período seleccionado.",
    });

    function syncTabSelectAll() {
      var allCheckEl = document.getElementById("asigTabSelectAll");
      if (!allCheckEl || !asigTabulator) return;
      var activeRows = asigTabulator.getRows("active");
      var total = activeRows.length;
      var arr = app.asignacionesState.selectedAgenteIdsVista || [];
      var counted = 0;
      activeRows.forEach(function (r) {
        if (arr.indexOf(Number(r.getData().agente_id)) !== -1) counted++;
      });
      allCheckEl.indeterminate = counted > 0 && counted < total;
      allCheckEl.checked = total > 0 && counted === total;
    }
    // Store reference so the permanent delegation can always call the latest version
    app.asignacionesState._syncTabSelectAll = syncTabSelectAll;

    asigTabulator.on("dataFiltered", function (filters, rows) {
      updateSearchSummary(rows.length, totalAgentes);
      syncTabSelectAll();
    });

    // Bind the select-all header checkbox after Tabulator renders
    setTimeout(function () {
      var allCheckEl = document.getElementById("asigTabSelectAll");
      if (allCheckEl && !allCheckEl.dataset.tabBound) {
        allCheckEl.dataset.tabBound = "1";
        allCheckEl.addEventListener("change", function () {
          var activeRows = asigTabulator ? asigTabulator.getRows("active") : [];
          var arr = app.asignacionesState.selectedAgenteIdsVista || [];
          activeRows.forEach(function (r) {
            var agenteId = Number(r.getData().agente_id);
            var idx = arr.indexOf(agenteId);
            if (allCheckEl.checked && idx === -1) {
              arr.push(agenteId);
            } else if (!allCheckEl.checked && idx !== -1) {
              arr.splice(idx, 1);
            }
          });
          app.asignacionesState.selectedAgenteIdsVista = arr;
          // Update rendered checkboxes directly (virtual DOM – only rendered rows)
          container
            .querySelectorAll(".asig-tab-row-check")
            .forEach(function (cb) {
              cb.checked = allCheckEl.checked;
            });
          refreshMetaResumenFromState();
        });
      }
      syncTabSelectAll();
    }, 0);

    // ── Event delegation for icon clicks inside Tabulator cells ───────────
    // Only bind once per container element to avoid duplicate handlers
    if (!container.dataset.asigTabDelegates) {
      container.dataset.asigTabDelegates = "1";
      container.addEventListener("click", function (e) {
        // Row selection checkbox
        var rowCheck =
          e.target &&
          e.target.classList &&
          e.target.classList.contains("asig-tab-row-check")
            ? e.target
            : null;
        if (rowCheck) {
          var agenteId = Number(rowCheck.getAttribute("data-agente-id"));
          var arr = app.asignacionesState.selectedAgenteIdsVista || [];
          var idx = arr.indexOf(agenteId);
          if (rowCheck.checked && idx === -1) {
            arr.push(agenteId);
          } else if (!rowCheck.checked && idx !== -1) {
            arr.splice(idx, 1);
          }
          app.asignacionesState.selectedAgenteIdsVista = arr;
          if (typeof app.asignacionesState._syncTabSelectAll === "function") {
            app.asignacionesState._syncTabSelectAll();
          }
          refreshMetaResumenFromState();
          return;
        }
        // Observaciones icon inside day cell
        var obsIcon =
          e.target && e.target.closest
            ? e.target.closest(".asig-cell-comentario-icon")
            : null;
        if (obsIcon) {
          e.stopPropagation();
          var obs = obsIcon.getAttribute("data-obs");
          if (!obs) return;
          var modal = document.getElementById("asigCellComentarioModal");
          if (!modal) {
            modal = document.createElement("div");
            modal.id = "asigCellComentarioModal";
            modal.innerHTML =
              '<div class="modal fade" tabindex="-1"><div class="modal-dialog"><div class="modal-content">' +
              '<div class="modal-header"><h5 class="modal-title">Observación de la asignación</h5>' +
              '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>' +
              '<div class="modal-body"><div id="asigCellComentarioModalBody"></div></div>' +
              '<div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button></div>' +
              "</div></div></div>";
            document.body.appendChild(modal);
          }
          document.getElementById("asigCellComentarioModalBody").textContent =
            obs;
          bootstrap.Modal.getOrCreateInstance(
            modal.querySelector(".modal"),
          ).show();
          return;
        }
        // Comentarios icon inside agente cell
        var comentarioIcon =
          e.target && e.target.closest
            ? e.target.closest(".asig-comentario-icon")
            : null;
        if (comentarioIcon) {
          e.stopPropagation();
          var agenteId = Number(comentarioIcon.getAttribute("data-agente-id"));
          var agRow = null;
          if (asigTabulator) {
            var allRows = asigTabulator.getRows();
            for (var ri = 0; ri < allRows.length; ri++) {
              if (Number(allRows[ri].getData().agente_id) === agenteId) {
                agRow = allRows[ri].getData();
                break;
              }
            }
          }
          if (!agRow || !agRow.comentarios) return;
          var cModal = document.getElementById("asigComentarioModal");
          if (!cModal) {
            cModal = document.createElement("div");
            cModal.id = "asigComentarioModal";
            cModal.innerHTML =
              '<div class="modal fade" tabindex="-1"><div class="modal-dialog"><div class="modal-content">' +
              '<div class="modal-header"><h5 class="modal-title">Comentarios del agente</h5>' +
              '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>' +
              '<div class="modal-body"><div id="asigComentarioModalBody"></div></div>' +
              '<div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button></div>' +
              "</div></div></div>";
            document.body.appendChild(cModal);
          }
          document.getElementById("asigComentarioModalBody").textContent =
            agRow.comentarios;
          bootstrap.Modal.getOrCreateInstance(
            cModal.querySelector(".modal"),
          ).show();
        }
      });
    }
  }

  app.loadAsignacionesMeta = async function loadAsignacionesMeta() {
    const now = new Date();
    const anioEl = document.getElementById("asigAnio");
    const mesEl = document.getElementById("asigMes");

    if (anioEl && !anioEl.value) anioEl.value = String(now.getFullYear());
    if (mesEl && !mesEl.options.length) {
      mesEl.innerHTML = MONTHS.map(function (m, idx) {
        const val = idx + 1;
        return '<option value="' + val + '">' + m + "</option>";
      }).join("");
      mesEl.value = String(now.getMonth() + 1);
    }

    try {
      const res = await fetch("/api/asignaciones/meta", { headers: headers() });
      if (!res.ok)
        throw new Error("No se pudieron cargar metadatos de asignaciones");
      const json = await res.json();
      app.asignacionesState.meta = json;
      if (typeof app.asignacionesState.searchTerm !== "string") {
        app.asignacionesState.searchTerm = "";
      }
      //renderMetaResumen(json);
      //Nueva llamada a renderizar resumen, con conteo de agentes con cuadrante completo (sin días sin asignar)
      refreshMetaResumenFromState();
      app.asignacionesState.borradorId = null;
      await app.loadAsignacionesBorradores();
      await app.loadAsignacionesCuadrante();
    } catch (e) {
      showAlert(e.message, "danger");
    }
  };

  app.loadAsignacionesCuadrante = async function loadAsignacionesCuadrante(forceBorradorId) {
    const periodo = getPeriodo();
    if (!periodo.anio || !periodo.mes) {
      showAlert("Seleccione año y mes válidos", "warning");
      return;
    }

    app.asignacionesState.anio = periodo.anio;
    app.asignacionesState.mes = periodo.mes;

    let borradorId = forceBorradorId || getSelectedBorradorId();
    app.asignacionesState.borradorId = borradorId;

    const planningDays = getPlanningWindow(periodo.anio, periodo.mes);
    const periodSet = new Set(
      planningDays.map(function (d) {
        return periodoKey(d.anio, d.mes);
      }),
    );
    const periodList = Array.from(periodSet).map(function (k) {
      const parts = k.split("-");
      return { anio: Number(parts[0]), mes: Number(parts[1]), key: k };
    });

    const container = document.getElementById("asigGridContainer");
    if (container) {
      container.innerHTML =
        '<div class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2" role="status"></div>Cargando cuadrante...</div>';
    }

    try {
      // Si no hay borrador seleccionado, intentar crear uno automáticamente antes de cargar
        if (!borradorId) {
          const currentBorradores = app.asignacionesState.borradores || [];
          const canonico = currentBorradores.find(function (b) {
            return b.estado === "validado" || b.estado === "modificado";
          });

          if (canonico) {
            borradorId = canonico.id;
            app.asignacionesState.borradorId = borradorId;
            const borradorEl = document.getElementById("asigBorrador");
            if (borradorEl) borradorEl.value = String(borradorId);
          } else {
            showAlert(
              "No hay borrador canónico para este período. Cree uno manualmente.",
              "warning",
            );
            return;
          }
        }

      const responses = await Promise.all(
        periodList.map(async function (p) {
          const qs =
            borradorId && p.anio === periodo.anio && p.mes === periodo.mes
              ? "?borrador_id=" + encodeURIComponent(String(borradorId))
              : "";
          const res = await fetch(
            "/api/asignaciones/cuadrante/" + p.anio + "/" + p.mes + qs,
            { headers: headers() },
          );
          if (!res.ok)
            throw new Error("No se pudo cargar el cuadrante de " + p.key);
          const json = await res.json();
          return { key: p.key, data: json };
        }),
      );

      const selectedKey = periodoKey(periodo.anio, periodo.mes);
      const selected = responses.find(function (r) {
        return r.key === selectedKey;
      });

      const merged = {
        control: selected ? selected.data.control || null : null,
        borrador: [],
        borradorServicios: [],
        definitivo: [],
        definitivoServicios: [],
      };

      responses.forEach(function (r) {
        const d = r.data || {};
        merged.borrador = merged.borrador.concat(d.borrador || []);
        merged.borradorServicios = merged.borradorServicios.concat(
          d.borradorServicios || [],
        );
        merged.definitivo = merged.definitivo.concat(d.definitivo || []);
        merged.definitivoServicios = merged.definitivoServicios.concat(
          d.definitivoServicios || [],
        );
      });

      app.asignacionesState.control = merged.control;
      app.asignacionesState.cuadrante = merged;
      // El control se renderiza aparte porque no forma parte de los datos del grid, pero puede contener información relevante como bloqueos o permisos que afectan la interacción con el cuadrante
      refreshMetaResumenFromState();
      renderEstado(merged.control || null);
      renderGridTabulator(merged, periodo.anio, periodo.mes);
    } catch (e) {
      showAlert(e.message, "danger");
      if (container)
        container.innerHTML =
          '<div class="text-center text-danger py-4">Error al cargar cuadrante</div>';
    }
  };

  app.setupAsignacionesEventListeners =
    function setupAsignacionesEventListeners() {
      const reloadBtn = document.getElementById("btnReloadAsignaciones");
      if (!reloadBtn) return;

      if (reloadBtn.dataset.bound === "1") return;
      reloadBtn.dataset.bound = "1";

      reloadBtn.addEventListener("click", async function () {
        // Limpiar cache local antes de recargar
        if (app.asignacionesState) {
          app.asignacionesState.cuadrante = null;
          app.asignacionesState.borradores = [];
          app.asignacionesState.borradorId = null;
          app.asignacionesState.control = null;
        }
        await app.loadAsignacionesBorradores();
        await app.loadAsignacionesCuadrante();
      });

      const anioEl = document.getElementById("asigAnio");
      const mesEl = document.getElementById("asigMes");
      const borrSel = document.getElementById("asigBorrador");
      const nuevoBorrBtn = document.getElementById("btnAsigNuevoBorrador");
      const searchEl = document.getElementById("asigSearchAgente");

      if (searchEl && searchEl.dataset.bound !== "1") {
        searchEl.dataset.bound = "1";
        searchEl.value = app.asignacionesState.searchTerm || "";
        searchEl.addEventListener("input", function () {
          app.asignacionesState.searchTerm = searchEl.value || "";
          if (asigTabulator) {
            var term = normalizeSearchText(searchEl.value || "");
            if (!term) {
              asigTabulator.clearFilter();
            } else {
              asigTabulator.setFilter(function (rowData) {
                var searchable = [
                  rowData.tip,
                  rowData.nombre,
                  rowData.empleo_nombre,
                  rowData.peloton_codigo,
                  String(rowData.orden_gc || ""),
                  rowData.situacion,
                  Array.isArray(rowData.aptitudes)
                    ? rowData.aptitudes.join(" ")
                    : rowData.aptitudes || "",
                  rowData.comentarios,
                ].join(" ");
                var dayKeys = Object.keys(rowData).filter(function (k) {
                  return k.indexOf("dia_") === 0;
                });
                dayKeys.forEach(function (k) {
                  var d = rowData[k];
                  if (d) {
                    searchable +=
                      " " +
                      (d.turnoLabel || "") +
                      " " +
                      (d.servicios || [])
                        .map(function (s) {
                          return s.label || "";
                        })
                        .join(" ") +
                      " " +
                      (d.observaciones || "");
                  }
                });
                return normalizeSearchText(searchable).indexOf(term) !== -1;
              });
            }
          } else {
            updateSearchSummary(0, 0);
          }
        });
      }

      const clearAllBtn = document.getElementById("asigClearAllFilters");
      if (clearAllBtn && clearAllBtn.dataset.bound !== "1") {
        clearAllBtn.dataset.bound = "1";
        clearAllBtn.addEventListener("click", function () {
          app.asignacionesState.searchTerm = "";
          app.asignacionesState.columnFilters = {
            tip: "",
            agente: "",
            peloton: "",
            pei: "",
            paef: "",
            orden_gc: "",
          };
          app.asignacionesState.columnFilterFocus = null;
          if (searchEl) searchEl.value = "";
          if (asigTabulator) {
            asigTabulator.clearHeaderFilter();
            asigTabulator.clearFilter();
          } else {
            updateSearchSummary(0, 0);
          }
        });
      }

      if (anioEl && anioEl.dataset.bound !== "1") {
        anioEl.dataset.bound = "1";
        anioEl.addEventListener("change", async function () {
          await app.loadAsignacionesBorradores();
          app.loadAsignacionesCuadrante();
        });
      }
      if (mesEl && mesEl.dataset.bound !== "1") {
        mesEl.dataset.bound = "1";
        mesEl.addEventListener("change", async function () {
          await app.loadAsignacionesBorradores();
          app.loadAsignacionesCuadrante();
        });
      }
      if (borrSel && borrSel.dataset.bound !== "1") {
        borrSel.dataset.bound = "1";
        borrSel.addEventListener("change", function () {
          app.asignacionesState.borradorId = getSelectedBorradorId();
          updateObsBtnStyle();
          app.loadAsignacionesCuadrante();
        });
      }
      if (nuevoBorrBtn && nuevoBorrBtn.dataset.bound !== "1") {
        nuevoBorrBtn.dataset.bound = "1";
        nuevoBorrBtn.addEventListener("click", function () {
          // Poblar el select "copiar desde" con los borradores actuales
          const borradores = app.asignacionesState.borradores || [];
          const copiaSel = document.getElementById("nuevoCopiaDesdeBorrador");
          if (copiaSel) {
            copiaSel.innerHTML =
              '<option value="">— Empezar vacío —</option>' +
              borradores
                .map(function (b) {
                  const tag = b.estado === "validado" ? " (validado)" : "";
                  return (
                    '<option value="' +
                    b.id +
                    '">' +
                    app.escapeHtml(
                      (b.nombre || "Borrador") + " v" + (b.version || 1) + tag,
                    ) +
                    "</option>"
                  );
                })
                .join("");
            copiaSel.selectedIndex = 0;
          }
          const modalEl = document.getElementById("modalNuevoBorrador");
          if (modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).show();
        });
      }

      const confirmarBorrBtn = document.getElementById(
        "btnConfirmarNuevoBorrador",
      );
      if (confirmarBorrBtn && confirmarBorrBtn.dataset.bound !== "1") {
        confirmarBorrBtn.dataset.bound = "1";
        confirmarBorrBtn.addEventListener("click", async function () {
          const p = getPeriodo();
          const copiaSel = document.getElementById("nuevoCopiaDesdeBorrador");
          const obsEl = document.getElementById("nuevoObservacionesBorrador");
          var nombre =
            "Borrador " + p.anio + "-" + String(p.mes).padStart(2, "0");


          const copia_de_id =
            copiaSel && copiaSel.value ? Number(copiaSel.value) : null;
          try {
            const body = { anio: p.anio, mes: p.mes, nombre };
            if (copia_de_id) body.copia_de_id = copia_de_id;
            if (obsEl && obsEl.value.trim())
              body.observaciones = obsEl.value.trim();
            const res = await fetch("/api/asignaciones/borradores", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Authorization: "Bearer " + app.globalState.token,
              },
              body: JSON.stringify(body),
            });
            const json = await res.json();
            if (!res.ok || !json.ok)
              throw new Error(
                (json && json.message) || "No se pudo crear el borrador",
              );
            const modalEl = document.getElementById("modalNuevoBorrador");
            if (modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).hide();
            if (obsEl) obsEl.value = "";
            const newBorradorId = json.borrador && json.borrador.id;
            // Forzar la selección del nuevo borrador ANTES de cargar el cuadrante
            if (newBorradorId) {
              app.asignacionesState.borradorId = newBorradorId;
              const borrSel = document.getElementById("asigBorrador");
              if (borrSel) borrSel.value = String(newBorradorId);
            }
            await app.loadAsignacionesBorradores(newBorradorId);
            showAlert("Borrador creado: " + nombre, "success");
            await app.loadAsignacionesCuadrante(newBorradorId);
          } catch (e) {
            showAlert(e.message, "danger");
          }
        });
      }

      const editObsBtn = document.getElementById(
        "btnEditObservacionesBorrador",
      );
      if (editObsBtn && editObsBtn.dataset.bound !== "1") {
        editObsBtn.dataset.bound = "1";
        editObsBtn.addEventListener("click", function () {
          const borradorId = getSelectedBorradorId();
          if (!borradorId) {
            showAlert("Seleccione un borrador primero", "warning");
            return;
          }
          const borradores = app.asignacionesState.borradores || [];
          const borrador = borradores.find(function (b) {
            return Number(b.id) === Number(borradorId);
          });
          const titulo = borrador
            ? borrador.nombre + " v" + (borrador.version || 1)
            : "Borrador";
          const tituloEl = document.getElementById("obsModalTitulo");
          const textEl = document.getElementById("editObservacionesBorrador");
          if (tituloEl) tituloEl.textContent = titulo;
          if (textEl)
            textEl.value =
              borrador && borrador.observaciones ? borrador.observaciones : "";
          const modalEl = document.getElementById("modalObservacionesBorrador");
          if (modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).show();
        });
      }

      const guardarObsBtn = document.getElementById(
        "btnGuardarObservacionesBorrador",
      );
      if (guardarObsBtn && guardarObsBtn.dataset.bound !== "1") {
        guardarObsBtn.dataset.bound = "1";
        guardarObsBtn.addEventListener("click", async function () {
          const borradorId = getSelectedBorradorId();
          if (!borradorId) return;
          const textEl = document.getElementById("editObservacionesBorrador");
          const observaciones = textEl ? textEl.value.trim() : "";
          try {
            const res = await fetch(
              "/api/asignaciones/borradores/" + borradorId + "/observaciones",
              {
                method: "PATCH",
                headers: {
                  "Content-Type": "application/json",
                  Authorization: "Bearer " + app.globalState.token,
                },
                body: JSON.stringify({ observaciones }),
              },
            );
            const json = await res.json();
            if (!res.ok || !json.ok)
              throw new Error((json && json.message) || "Error al guardar");
            // Actualizar en memoria local
            const borradores = app.asignacionesState.borradores || [];
            const b = borradores.find(function (b) {
              return Number(b.id) === Number(borradorId);
            });
            if (b) b.observaciones = observaciones;
            updateObsBtnStyle();
            const modalEl = document.getElementById(
              "modalObservacionesBorrador",
            );
            if (modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).hide();
            showAlert("Observaciones guardadas", "success");
          } catch (e) {
            showAlert(e.message, "danger");
          }
        });
      }

      const deleteBorradorBtn = document.getElementById(
        "btnAsigDeleteBorrador",
      );
      if (deleteBorradorBtn && deleteBorradorBtn.dataset.bound !== "1") {
        deleteBorradorBtn.dataset.bound = "1";
        deleteBorradorBtn.addEventListener("click", function () {
          const borradorId = getSelectedBorradorId();
          if (!borradorId) {
            showAlert("Debe seleccionar un borrador para eliminar", "warning");
            return;
          }

          // Encontrar el nombre del borrador seleccionado
          const borradores = app.asignacionesState.borradores || [];
          const borrador = borradores.find(function (b) {
            return Number(b.id) === Number(borradorId);
          });
          const nombre = borrador ? borrador.nombre || "Borrador" : "Borrador";

          // Mostrar modal de confirmación
          const modalEl = ensureConfirmBorradorModal();
          const nombreEl = document.getElementById("asigConfirmBorradorNombre");
          if (nombreEl) {
            nombreEl.textContent = nombre;
          }

          // Limpiar manejador anterior del botón de confirmar
          const btnConfirm = document.getElementById(
            "btnConfirmDeleteBorrador",
          );
          if (btnConfirm) {
            var newBtn = btnConfirm.cloneNode(true);
            btnConfirm.parentNode.replaceChild(newBtn, btnConfirm);

            // Agregar manejador al nuevo botón
            document
              .getElementById("btnConfirmDeleteBorrador")
              .addEventListener("click", async function () {
                try {
                  const res = await fetch(
                    "/api/asignaciones/borradores/" + borradorId,
                    {
                      method: "DELETE",
                      headers: {
                        "Content-Type": "application/json",
                        Authorization: "Bearer " + app.globalState.token,
                      },
                    },
                  );

                  const json = await res.json();
                  if (!res.ok || !json.ok) {
                    throw new Error(
                      json.message || "Error al eliminar borrador",
                    );
                  }

                  bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                  await app.loadAsignacionesBorradores();
                  await app.loadAsignacionesCuadrante();
                  showAlert("Borrador eliminado correctamente", "success");
                } catch (e) {
                  showAlert(e.message, "danger");
                }
              });
          }

          bootstrap.Modal.getOrCreateInstance(modalEl).show();
        });
      }

      const bulkBtn = document.getElementById("btnAsigBulk");
      if (bulkBtn && bulkBtn.dataset.bound !== "1") {
        bulkBtn.dataset.bound = "1";
        bulkBtn.addEventListener("click", function () {
          const modalEl = ensureAsignacionesBulkModal();
          const p = getPeriodo();
          fillAgenteOptions(document.getElementById("asigBulkAgentes"), {
            onlySelectedForBulk: true,
            preselectAll: true,
            hintEl: document.getElementById("asigBulkAgentesHint"),
          });
          fillTurnosOptions(document.getElementById("asigBulkTurno"));
          fillActividadesOptions(
            document.getElementById("asigBulkActividades"),
          );
          document.getElementById("asigBulkObservaciones").value = "";

          // Poblar select de días con planning window
          const diasEl = document.getElementById("asigBulkDias");
          const planningDays = getPlanningWindow(p.anio, p.mes);
          diasEl.innerHTML = planningDays
            .map(function (day) {
              return (
                '<option value="' +
                day.key +
                '" data-dia="' +
                day.dia +
                '">' +
                day.label +
                " " +
                day.labelDate +
                "</option>"
              );
            })
            .join("");

          // Filtros de búsqueda
          var filterAgBulk = document.getElementById("asigBulkFilterAgentes");
          if (filterAgBulk) {
            filterAgBulk.value = "";
            attachSelectFilter(
              filterAgBulk,
              document.getElementById("asigBulkAgentes"),
            );
          }
          var filterActBulk = document.getElementById(
            "asigBulkFilterActividades",
          );
          if (filterActBulk) {
            filterActBulk.value = "";
            attachSelectFilter(
              filterActBulk,
              document.getElementById("asigBulkActividades"),
            );
          }

          // Checkbox marcar todos agentes
          const checkAllAgentes = document.getElementById(
            "asigBulkCheckAllAgentes",
          );
          const agentesEl = document.getElementById("asigBulkAgentes");
          const bulkWarnWrap = document.getElementById(
            "asigBulkSelectionWarningWrap",
          );
          const saveBulkBtn = document.getElementById("btnSaveAsigBulk");
          const selectedCountEl = document.getElementById(
            "asigBulkSelectedCount",
          );

          function updateBulkApplyEnabledState() {
            var selectedAgentsCount = Array.from(
              agentesEl?.selectedOptions || [],
            ).length;
            var totalAgentsCount = Number(agentesEl?.options?.length || 0);
            var hasSelectedAgents = selectedAgentsCount > 0;

            if (saveBulkBtn) saveBulkBtn.disabled = !hasSelectedAgents;
            if (bulkWarnWrap) {
              bulkWarnWrap.classList.toggle("d-none", hasSelectedAgents);
            }
            if (selectedCountEl) {
              selectedCountEl.textContent =
                "Agentes seleccionados: " +
                selectedAgentsCount +
                " de " +
                totalAgentsCount;
            }
          }

          if (checkAllAgentes && agentesEl) {
            checkAllAgentes.checked = agentesEl.options.length > 0;
            checkAllAgentes.onclick = function () {
              for (var i = 0; i < agentesEl.options.length; i++) {
                agentesEl.options[i].selected = checkAllAgentes.checked;
              }
              updateBulkApplyEnabledState();
            };

            agentesEl.addEventListener("change", function () {
              var selectedCount = Array.from(
                agentesEl.selectedOptions || [],
              ).length;
              if (!agentesEl.options.length) {
                checkAllAgentes.checked = false;
                checkAllAgentes.indeterminate = false;
              } else if (selectedCount === agentesEl.options.length) {
                checkAllAgentes.checked = true;
                checkAllAgentes.indeterminate = false;
              } else if (selectedCount > 0) {
                checkAllAgentes.checked = false;
                checkAllAgentes.indeterminate = true;
              } else {
                checkAllAgentes.checked = false;
                checkAllAgentes.indeterminate = false;
              }
              updateBulkApplyEnabledState();
            });
          }

          updateBulkApplyEnabledState();

          // Checkbox marcar todos días
          const checkAllDias = document.getElementById("asigBulkCheckAllDias");
          if (checkAllDias && diasEl) {
            checkAllDias.checked = false;
            checkAllDias.onclick = function () {
              for (var i = 0; i < diasEl.options.length; i++) {
                diasEl.options[i].selected = checkAllDias.checked;
              }
            };
          }

          resetBulkProgress();

          document.getElementById("btnSaveAsigBulk").onclick =
            async function () {
              resetBulkProgress();

              // ── Recoger datos del formulario ──
              const periodo = getPeriodo();
              const agenteIds = getSelectedNumbersFromSelect(
                document.getElementById("asigBulkAgentes"),
              );
              const dias = Array.from(diasEl.selectedOptions)
                .map(function (opt) {
                  return opt.value;
                })
                .filter(Boolean);
              const turnoId = Number(
                document.getElementById("asigBulkTurno").value || 0,
              );
              const actividadIds = getSelectedNumbersFromSelect(
                document.getElementById("asigBulkActividades"),
              );
              const observaciones =
                document.getElementById("asigBulkObservaciones").value.trim() ||
                null;
              const saveBtn = document.getElementById("btnSaveAsigBulk");
              const closeBtn = modalEl.querySelector(
                '[data-bs-dismiss="modal"]',
              );

              // ── Validaciones ──
              if (
                !agenteIds.length ||
                !dias.length ||
                !turnoId ||
                !actividadIds.length
              ) {
                showAlert(
                  "Complete agentes, días, turno y actividades para asignación masiva",
                  "warning",
                );
                return;
              }

              try {
                // Bloquear botones durante el proceso
                if (saveBtn) {
                  saveBtn.disabled = true;
                  saveBtn.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Procesando...';
                }
                if (closeBtn) closeBtn.disabled = true;

                // ── Fase 1: Enviar lotes al servidor (5 en paralelo) ──
                var chunks = chunkItems(
                  agenteIds,
                  BULK_REQUEST_AGENT_CHUNK_SIZE,
                );
                var totalChunks = chunks.length;
                var totalCells = agenteIds.length * dias.length;
                var processedAgents = 0;
                var totalApplied = 0;
                var MAX_PARALLEL = 5;
                var borradorId = getSelectedBorradorId();

                updateBulkProgress(5, "Enviando " + totalChunks + " lotes...");

                for (var ci = 0; ci < chunks.length; ci += MAX_PARALLEL) {
                  var batch = chunks.slice(ci, ci + MAX_PARALLEL);

                  // Lanzar hasta 5 lotes en paralelo
                  var batchPromises = batch.map(function (chunk, batchIdx) {
                    var loteNum = ci + batchIdx + 1;
                    return fetch("/api/asignaciones/bulk", {
                      method: "POST",
                      headers: {
                        "Content-Type": "application/json",
                        Authorization: "Bearer " + app.globalState.token,
                        "X-Asig-Client-Version": ASIG_FE_VERSION,
                      },
                      body: JSON.stringify({
                        anio: periodo.anio,
                        mes: periodo.mes,
                        borrador_id: borradorId,
                        agente_ids: chunk,
                        dias: dias,
                        turno_id: turnoId,
                        actividad_ids: actividadIds,
                        observaciones: observaciones,
                      }),
                    }).then(function (res) {
                      return res.json().then(function (json) {
                        return {
                          res: res,
                          json: json,
                          lote: loteNum,
                          chunk: chunk,
                        };
                      });
                    });
                  });

                  // Esperar a que terminen los 5 del batch
                  var batchResults = await Promise.all(batchPromises);

                  // Verificar errores
                  for (var bi = 0; bi < batchResults.length; bi++) {
                    var br = batchResults[bi];
                    if (br.res.status === 409) {
                      showAlert("La celda fue modificada por otro usuario. Recargando cuadrante...", "warning");
                      await app.loadAsignacionesCuadrante();
                      return;
                    }
                    if (!br.res.ok || (br.json && br.json.ok === false)) {
                      throw new Error(
                        (br.json && br.json.message) ||
                          "Error en lote " + br.lote,
                      );
                    }
                    totalApplied += Number(
                      br.json && br.json.count
                        ? br.json.count
                        : br.chunk.length * dias.length,
                    );
                  }

                  // Actualizar barra de progreso (0-80% para envío)
                  processedAgents += batch.reduce(function (sum, c) {
                    return sum + c.length;
                  }, 0);
                  updateBulkProgress(
                    5 + (processedAgents / agenteIds.length) * 75,
                    "Lotes: " +
                      Math.min(ci + MAX_PARALLEL, chunks.length) +
                      "/" +
                      totalChunks +
                      " · " +
                      totalApplied +
                      " celdas",
                  );
                }

                // ── Fase 2: Recargar cuadrante (80-100%) ──
                updateBulkProgress(85, "Recargando cuadrante...");
                await app.loadAsignacionesCuadrante();

                // ── Finalizar ──
                updateBulkProgress(
                  100,
                  "Completado: " + totalApplied + " celdas",
                );
                showAlert(
                  "Asignación masiva aplicada en borrador: " +
                    totalApplied +
                    " celdas. El modal permanece abierto.",
                  "success",
                );
                setTimeout(resetBulkProgress, 1200);
              } catch (e) {
                showAlert(e.message, "danger");
              } finally {
                // Restaurar botones siempre
                if (saveBtn) {
                  saveBtn.disabled = false;
                  saveBtn.innerHTML =
                    '<i class="bi bi-check2 me-1"></i>Aplicar';
                }
                if (closeBtn) closeBtn.disabled = false;
              }
            };

          bootstrap.Modal.getOrCreateInstance(modalEl).show();
        });
      }

      const deleteBtn = document.getElementById("btnAsigDelete");
      if (deleteBtn && deleteBtn.dataset.bound !== "1") {
        deleteBtn.dataset.bound = "1";
        deleteBtn.addEventListener("click", function () {
          const modalEl = ensureAsignacionesDeleteModal();
          const p = getPeriodo();
          fillAgenteOptions(document.getElementById("asigDeleteAgentes"), {
            onlySelectedForBulk: true,
            preselectAll: true,
            hintEl: document.getElementById("asigDeleteAgentesHint"),
          });
          renderDeleteDateOptions(p.anio, p.mes);

          // Filtro de búsqueda en agentes
          var filterAgDel = document.getElementById("asigDeleteFilterAgentes");
          if (filterAgDel) {
            filterAgDel.value = "";
            attachSelectFilter(
              filterAgDel,
              document.getElementById("asigDeleteAgentes"),
            );
          }

          // Checkbox marcar todos agentes
          var checkAllAgDel = document.getElementById(
            "asigDeleteCheckAllAgentes",
          );
          var agentesDelEl = document.getElementById("asigDeleteAgentes");
          if (checkAllAgDel && agentesDelEl) {
            checkAllAgDel.checked = false;
            checkAllAgDel.onclick = function () {
              for (var i = 0; i < agentesDelEl.options.length; i++) {
                agentesDelEl.options[i].selected = checkAllAgDel.checked;
              }
            };
          }

          // Checkbox marcar todas las fechas
          var checkAllFechasDel = document.getElementById(
            "asigDeleteCheckAllFechas",
          );
          if (checkAllFechasDel) {
            checkAllFechasDel.checked = false;
            checkAllFechasDel.onclick = function () {
              var checks = document.querySelectorAll(
                "#asigDeleteDates .asig-delete-date-check",
              );
              checks.forEach(function (cb) {
                cb.checked = checkAllFechasDel.checked;
              });
              // Trigger summary update
              if (checks.length) checks[0].dispatchEvent(new Event("change"));
            };
          }

          document.getElementById("btnRunAsigDelete").onclick =
            async function () {
              const agenteIds = getSelectedNumbersFromSelect(
                document.getElementById("asigDeleteAgentes"),
              );
              const fechas = getSelectedDeleteDates();
              const dias = fechas.map(function (fecha) {
                return Number(String(fecha).slice(8, 10));
              });
              if (!agenteIds.length || !fechas.length) {
                showAlert(
                  "Seleccione agentes y fechas para eliminar",
                  "warning",
                );
                return;
              }

              try {
                const res = await fetch("/api/asignaciones/borrador", {
                  method: "DELETE",
                  headers: {
                    "Content-Type": "application/json",
                    Authorization: "Bearer " + app.globalState.token,
                  },
                  body: JSON.stringify({
                    anio: p.anio,
                    mes: p.mes,
                    borrador_id: getSelectedBorradorId(),
                    agente_ids: agenteIds,
                    dias: dias,
                    fechas: fechas,
                  }),
                });
                if (!res.ok) {
                  const err = await res.json();
                  throw new Error(err.message || "Error al eliminar borrador");
                }
                bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                showAlert(
                  "Borrador eliminado para selección indicada",
                  "success",
                );
                await app.loadAsignacionesCuadrante();
              } catch (e) {
                showAlert(e.message, "danger");
              }
            };

          bootstrap.Modal.getOrCreateInstance(modalEl).show();
        });
      }

      const copyBtn = document.getElementById("btnAsigCopy");
      if (copyBtn && copyBtn.dataset.bound !== "1") {
        copyBtn.dataset.bound = "1";
        copyBtn.addEventListener("click", function () {
          const modalEl = ensureAsignacionesCopyModal();
          const p = getPeriodo();
          fillAgenteOptions(document.getElementById("asigCopyAgentes"), {
            preselectSelected: true,
          });

          var copyOrigenMesEl = document.getElementById("asigCopyOrigenMes");
          var copyDestinoMesEl = document.getElementById("asigCopyDestinoMes");
          var monthOptions = MONTHS.map(function (m) {
            return (
              '<option value="' +
              app.escapeHtml(m) +
              '">' +
              app.escapeHtml(m) +
              "</option>"
            );
          }).join("");
          if (copyOrigenMesEl) copyOrigenMesEl.innerHTML = monthOptions;
          if (copyDestinoMesEl) copyDestinoMesEl.innerHTML = monthOptions;

          document.getElementById("asigCopyOrigenAnio").value = String(
            p.anio || new Date().getFullYear(),
          );
          document.getElementById("asigCopyOrigenMes").value =
            mesNumberToString(p.mes || new Date().getMonth() + 1);
          document.getElementById("asigCopyDestinoAnio").value = String(
            p.anio || new Date().getFullYear(),
          );
          document.getElementById("asigCopyDestinoMes").value =
            mesNumberToString(p.mes || new Date().getMonth() + 1);

          renderCopyDateOptions(p.anio, p.mes);

          var checkAllFechasCopy = document.getElementById(
            "asigCopyCheckAllFechas",
          );
          if (checkAllFechasCopy) {
            checkAllFechasCopy.checked = false;
            checkAllFechasCopy.onclick = function () {
              var checks = document.querySelectorAll(
                "#asigCopyDates .asig-copy-date-check",
              );
              checks.forEach(function (cb) {
                cb.checked = checkAllFechasCopy.checked;
              });
              if (checks.length) checks[0].dispatchEvent(new Event("change"));
            };
          }

          var origenAnioEl = document.getElementById("asigCopyOrigenAnio");
          var origenMesEl = document.getElementById("asigCopyOrigenMes");
          function rerenderCopyDatesFromOrigen() {
            var oa = Number(origenAnioEl.value);
            var om = mesStringToNumber(origenMesEl.value);
            if (!oa || !om) return;
            renderCopyDateOptions(oa, om);
            if (checkAllFechasCopy) checkAllFechasCopy.checked = false;
          }
          if (origenAnioEl) origenAnioEl.onchange = rerenderCopyDatesFromOrigen;
          if (origenMesEl) origenMesEl.onchange = rerenderCopyDatesFromOrigen;

          document.getElementById("btnRunAsigCopy").onclick =
            async function () {
              var origenAnioNum = Number(
                document.getElementById("asigCopyOrigenAnio").value,
              );
              var origenMesNum = mesStringToNumber(
                document.getElementById("asigCopyOrigenMes").value,
              );
              var destinoAnioNum = Number(
                document.getElementById("asigCopyDestinoAnio").value,
              );
              var destinoMesNum = mesStringToNumber(
                document.getElementById("asigCopyDestinoMes").value,
              );
              var selectedFechas = getSelectedCopyDates();

              // Mapeo posicional: misma posición en el cuadrante origen → misma posición en destino
              // Semana 0 Lunes origen → Semana 0 Lunes destino, etc.
              var origenWindow = getPlanningWindow(
                origenAnioNum,
                origenMesNum,
              ).map(function (d) {
                return d.key;
              });
              var destinoWindow = getPlanningWindow(
                destinoAnioNum,
                destinoMesNum,
              ).map(function (d) {
                return d.key;
              });
              var seen = {};
              var pares = [];
              selectedFechas.forEach(function (fecha) {
                if (seen[fecha]) return;
                seen[fecha] = true;
                var idx = origenWindow.indexOf(fecha);
                if (idx >= 0 && idx < destinoWindow.length) {
                  pares.push({ from: fecha, to: destinoWindow[idx] });
                }
              });

              const payload = {
                origen_anio: origenAnioNum,
                origen_mes: origenMesNum,
                origen_borrador_id: getSelectedBorradorId(),
                destino_anio: destinoAnioNum,
                destino_mes: destinoMesNum,
                destino_borrador_id: null,
                agente_ids: getSelectedNumbersFromSelect(
                  document.getElementById("asigCopyAgentes"),
                ),
                pares: pares,
              };

              if (
                !payload.origen_anio ||
                !payload.origen_mes ||
                !payload.destino_anio ||
                !payload.destino_mes
              ) {
                showAlert("Complete origen y destino válidos", "warning");
                return;
              }

              if (!payload.agente_ids.length) {
                showAlert(
                  "Debe marcar al menos un agente en la tabla/lista para copiar",
                  "warning",
                );
                return;
              }
              if (!payload.pares.length) {
                showAlert(
                  "Debe marcar al menos un día en el modal para copiar",
                  "warning",
                );
                return;
              }

              try {
                const res = await fetch("/api/asignaciones/copiar-mes", {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/json",
                    Authorization: "Bearer " + app.globalState.token,
                  },
                  body: JSON.stringify(payload),
                });
                if (!res.ok) {
                  const err = await res.json();
                  throw new Error(err.message || "Error al copiar mes");
                }

                const data = await res.json();
                bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                showAlert("Mes copiado al borrador destino", "success");

                const anioEl = document.getElementById("asigAnio");
                const mesEl = document.getElementById("asigMes");
                const borradorEl = document.getElementById("asigBorrador");
                if (anioEl) anioEl.value = String(payload.destino_anio);
                if (mesEl) mesEl.value = String(payload.destino_mes);
                // Pre-cargar borradores del mes destino para que el select tenga la opción
                await app.loadAsignacionesBorradores(data.destino_borrador_id);
                if (borradorEl && data.destino_borrador_id)
                  borradorEl.value = String(data.destino_borrador_id);
                await app.loadAsignacionesCuadrante();
              } catch (e) {
                showAlert(e.message, "danger");
              }
            };

          bootstrap.Modal.getOrCreateInstance(modalEl).show();
        });
      }

      const validateBtn = document.getElementById("btnAsigValidate");
      if (validateBtn && validateBtn.dataset.bound !== "1") {
        validateBtn.dataset.bound = "1";
        validateBtn.addEventListener("click", async function () {
          const p = getPeriodo();
          if (
            !window.confirm(
              "¿Validar borrador de " +
                p.anio +
                "/" +
                String(p.mes).padStart(2, "0") +
                "? Esta acción reemplaza el definitivo del período.",
            )
          ) {
            return;
          }
          try {
            const res = await fetch("/api/asignaciones/validar", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Authorization: "Bearer " + app.globalState.token,
              },
              body: JSON.stringify({
                anio: p.anio,
                mes: p.mes,
                borrador_id: getSelectedBorradorId(),
              }),
            });
            if (res.status === 409) {
              showAlert("Otro usuario está validando este periodo. Recargue.", "warning");
              return;
            }
            if (!res.ok) {
              const err = await res.json();
              throw new Error(err.message || "Error al validar borrador");
            }
            showAlert("Borrador validado correctamente", "success");
            await app.loadAsignacionesCuadrante();
          } catch (e) {
            showAlert(e.message, "danger");
          }
        });
      }

      var btnHistorialAsig = document.getElementById("btnAsigHistorial");
      if (btnHistorialAsig && btnHistorialAsig.dataset.bound !== "1") {
        btnHistorialAsig.dataset.bound = "1";
        btnHistorialAsig.addEventListener("click", function () {
          openAsignacionesHistorialModal();
        });
      }

      var btnHistorialAplicar = document.getElementById(
        "btnAsigHistorialAplicarFiltros",
      );
      if (btnHistorialAplicar && btnHistorialAplicar.dataset.bound !== "1") {
        btnHistorialAplicar.dataset.bound = "1";
        btnHistorialAplicar.disabled = true;
        btnHistorialAplicar.addEventListener("click", function () {
          loadAsignacionesHistorial();
        });
      }

      var btnHistorialLimpiar = document.getElementById(
        "btnAsigHistorialLimpiarFiltros",
      );
      if (btnHistorialLimpiar && btnHistorialLimpiar.dataset.bound !== "1") {
        btnHistorialLimpiar.dataset.bound = "1";
        btnHistorialLimpiar.addEventListener("click", function () {
          resetHistorialUiFilters();
          var sourceLogs =
            Array.isArray(app.asignacionesState.historialDateSourceLogs) &&
            app.asignacionesState.historialDateSourceLogs.length
              ? app.asignacionesState.historialDateSourceLogs
              : [];
          // Volver al estado inicial de apertura del modal
          var contentEl = document.getElementById("asigHistorialContent");
          if (contentEl) {
            contentEl.innerHTML = '<div class="text-center text-muted py-4">Selecciona los filtros y pulsa <strong>Consultar</strong> para cargar el historial.</div>';
          }
          var pdfBtn = document.getElementById("btnAsigHistorialPdf");
          if (pdfBtn) { pdfBtn.disabled = true; delete pdfBtn.dataset.query; }
          populateHistorialUsers(sourceLogs);
          populateHistorialDates(sourceLogs);
          renderHistorialResumen(0, getHistorialFilters());
        });
      }

      var historialActionEl = document.getElementById(
        "asigHistorialFiltroAccion",
      );
      if (historialActionEl && historialActionEl.dataset.bound !== "1") {
        historialActionEl.dataset.bound = "1";
        historialActionEl.addEventListener("change", function () {
          updateHistorialApplyButtonState();
        });
      }

      var historialUserEl = document.getElementById(
        "asigHistorialFiltroUsuario",
      );
      if (historialUserEl && historialUserEl.dataset.bound !== "1") {
        historialUserEl.dataset.bound = "1";
        historialUserEl.addEventListener("change", function () {
          updateHistorialApplyButtonState();
        });
      }

      var historialDateEl = document.getElementById(
        "asigHistorialFiltroFechaCambio",
      );
      if (historialDateEl && historialDateEl.dataset.bound !== "1") {
        historialDateEl.dataset.bound = "1";
        historialDateEl.addEventListener("change", function () {
          updateHistorialApplyButtonState();
        });
      }

      var btnHistorialPdf = document.getElementById("btnAsigHistorialPdf");
      if (btnHistorialPdf && btnHistorialPdf.dataset.bound !== "1") {
        btnHistorialPdf.dataset.bound = "1";
        btnHistorialPdf.addEventListener("click", async function () {
          var query = btnHistorialPdf.dataset.query;
          if (!query) return;
          try {
            btnHistorialPdf.disabled = true;
            var res = await fetch("/api/asignaciones/historial/pdf?" + query, {
              headers: headers(),
            });
            if (!res.ok) {
              var err = await res.json().catch(function () {
                return { message: "Error al exportar el historial a PDF" };
              });
              throw new Error(
                err.message || "Error al exportar el historial a PDF",
              );
            }
            var blob = await res.blob();
            var url = URL.createObjectURL(blob);
            var disposition = res.headers.get("Content-Disposition") || "";
            var match = disposition.match(/filename="?([^";]+)"?/i);
            var filename =
              match && match[1] ? match[1] : "historial_cuadrante.pdf";
            var link = document.createElement("a");
            link.href = url;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            link.remove();
            URL.revokeObjectURL(url);
          } catch (error) {
            showAlert(
              error.message || "Error al exportar el historial a PDF",
              "danger",
            );
          } finally {
            btnHistorialPdf.disabled = !btnHistorialPdf.dataset.query;
          }
        });
      }

      // ── Export & Grouping buttons (Tabulator mode only) ──────────────────
      var btnExcelAsig = document.getElementById("btnExportExcelAsig");
      if (btnExcelAsig && btnExcelAsig.dataset.bound !== "1") {
        btnExcelAsig.dataset.bound = "1";
        btnExcelAsig.onclick = async function () {
          try {
            var periodo = getPeriodo();
            if (!periodo.anio || !periodo.mes) {
              showAlert(
                "Selecciona año y mes para exportar el cuadrante.",
                "warning",
              );
              return;
            }

            var borradorId = getSelectedBorradorId();
            var params = new URLSearchParams({
              anio: String(periodo.anio),
              mes: String(periodo.mes),
            });

            if (borradorId) {
              params.set("borrador_id", String(borradorId));
              var borrador = (app.asignacionesState.borradores || []).find(
                function (b) {
                  return Number(b.id) === Number(borradorId);
                },
              );
              if (borrador && borrador.nombre) {
                params.set("nombre_borrador", borrador.nombre);
              }
            }

            var res = await fetch(
              "/api/asignaciones/exportar?" + params.toString(),
              {
                headers: headers(),
              },
            );

            if (!res.ok) {
              var err = await res.json().catch(function () {
                return { error: "Error al exportar cuadrante" };
              });
              throw new Error(err.error || "Error al exportar cuadrante");
            }

            var blob = await res.blob();
            var url = URL.createObjectURL(blob);
            var disposition = res.headers.get("Content-Disposition") || "";
            var match = disposition.match(/filename="?([^";]+)"?/i);
            var filename = match && match[1] ? match[1] : "cuadrante.xlsx";

            var link = document.createElement("a");
            link.href = url;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            link.remove();
            URL.revokeObjectURL(url);
          } catch (error) {
            showAlert(error.message || "Error al exportar cuadrante", "danger");
          }
        };
      }

      var btnPdfAsig = document.getElementById("btnExportPdfAsig");
      if (btnPdfAsig && btnPdfAsig.dataset.bound !== "1") {
        btnPdfAsig.dataset.bound = "1";
        btnPdfAsig.onclick = function () {
          if (asigTabulator)
            asigTabulator.download("pdf", "cuadrante.pdf", {
              orientation: "landscape",
              title: "Cuadrante de Asignaciones",
              autoTable: { styles: { fontSize: 6 } },
            });
        };
      }

      var btnGroupPeloton = document.getElementById("btnGroupByPeloton");
      if (btnGroupPeloton && btnGroupPeloton.dataset.bound !== "1") {
        btnGroupPeloton.dataset.bound = "1";
        btnGroupPeloton.onclick = function () {
          if (asigTabulator) asigTabulator.setGroupBy("peloton_codigo");
        };
      }

      var btnGroupEmpleo = document.getElementById("btnGroupByEmpleo");
      if (btnGroupEmpleo && btnGroupEmpleo.dataset.bound !== "1") {
        btnGroupEmpleo.dataset.bound = "1";
        btnGroupEmpleo.onclick = function () {
          if (asigTabulator) asigTabulator.setGroupBy("empleo_nombre");
        };
      }

      var btnGroupClear = document.getElementById("btnGroupClear");
      if (btnGroupClear && btnGroupClear.dataset.bound !== "1") {
        btnGroupClear.dataset.bound = "1";
        btnGroupClear.onclick = function () {
          if (asigTabulator) asigTabulator.setGroupBy(false);
        };
      }
    };
})();
